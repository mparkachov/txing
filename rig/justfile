set shell := ["sh", "-eu", "-c"]
set quiet := true

rig_dir := source_directory()
project_root := canonicalize(rig_dir + "/..")
tmp_dir := project_root + "/tmp"
export TMPDIR := tmp_dir
root_justfile := project_root + "/justfile"
bin_dir := rig_dir + "/target/local"
run_dir := env_var_or_default("TXING_RIG_RUN_DIR", "/tmp/txing-rig")
default_ipc_socket := run_dir + "/rig-ipc.sock"
config_dir := ""

[positional-arguments]
aws *args:
    #!/bin/sh
    set -eu
    eval "$(just --justfile "{{root_justfile}}" _project-aws-env rig)"
    command aws "$@"

test:
    #!/bin/sh
    set -eu
    cd "{{rig_dir}}"
    go test ./...

build:
    #!/bin/sh
    set -eu
    cd "{{rig_dir}}"
    install -d -m 755 "{{bin_dir}}"
    version_file="{{project_root}}/release/versions/rig"
    version="$(tr -d '[:space:]' < "$version_file")"
    if ! printf '%s\n' "$version" | grep -E -q '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
      echo "$version_file must contain a semantic version like x.y.z." >&2
      exit 1
    fi
    go build -ldflags "-X github.com/mparkachov/txing/rig/internal/version.Version=$version" \
      -o "{{bin_dir}}/txing-sparkplug-manager" ./cmd/txing-sparkplug-manager
    go build -ldflags "-X github.com/mparkachov/txing/rig/internal/version.Version=$version" \
      -o "{{bin_dir}}/txing-ble-connectivity" ./cmd/txing-ble-connectivity
    go build -ldflags "-X github.com/mparkachov/txing/rig/internal/version.Version=$version" \
      -o "{{bin_dir}}/txing-thread-connectivity" ./cmd/txing-thread-connectivity

start config_dir=config_dir:
    #!/bin/sh
    set -eu
    requested_config_dir="{{config_dir}}"
    case "$requested_config_dir" in *=*) echo "Do not pass just recipe arguments as name=value. Use positional arguments." >&2; exit 2 ;; esac
    requested_ipc_socket="${TXING_RIG_IPC_SOCKET:-}"
    if [ -n "$requested_config_dir" ]; then
      daemon_config_dir="$requested_config_dir"
    elif [ -n "${TXING_RIG_CONFIG_DIR:-}" ]; then
      daemon_config_dir="$TXING_RIG_CONFIG_DIR"
    else
      daemon_config_dir="$HOME/.config/txing/rig-daemon"
    fi
    daemon_env_file="$daemon_config_dir/daemon.env"
    if [ -f "$daemon_env_file" ]; then
      set -a
      . "$daemon_env_file"
      set +a
    fi
    if [ -n "$requested_ipc_socket" ]; then
      export TXING_RIG_IPC_SOCKET="$requested_ipc_socket"
    else
      export TXING_RIG_IPC_SOCKET="{{default_ipc_socket}}"
    fi
    config_bool() {
      name="$1"
      fallback="$2"
      eval "value=\${$name:-}"
      if [ -z "$value" ]; then
        value="$fallback"
      fi
      value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
      case "$value" in
        true|1|yes|on) return 0 ;;
        false|0|no|off) return 1 ;;
        *) echo "$name must be a boolean, got '$value'" >&2; exit 2 ;;
      esac
    }
    sparkplug_enabled=false
    ble_enabled=false
    thread_enabled=false
    if config_bool TXING_SPARKPLUG_MANAGER_ENABLED true; then sparkplug_enabled=true; fi
    if config_bool TXING_BLE_CONNECTIVITY_ENABLED false; then ble_enabled=true; fi
    if config_bool TXING_THREAD_CONNECTIVITY_ENABLED false; then thread_enabled=true; fi
    if [ "$sparkplug_enabled" != "true" ]; then
      if [ "$ble_enabled" = "true" ] || [ "$thread_enabled" = "true" ]; then
        echo "TXING_SPARKPLUG_MANAGER_ENABLED must be true when BLE or Thread connectivity is enabled." >&2
        exit 2
      fi
    fi
    just --justfile "{{rig_dir}}/justfile" build
    install -d -m 755 "{{run_dir}}"
    start_daemon() {
      daemon_name="$1"
      shift
      if [ -f "{{run_dir}}/${daemon_name}.pid" ] &&
        kill -0 "$(cat "{{run_dir}}/${daemon_name}.pid")" >/dev/null 2>&1; then
        echo "${daemon_name} already running"
        return 0
      fi
      if [ -n "$requested_config_dir" ]; then
        set -- "$@" --config-dir "$requested_config_dir"
      fi
      TXING_RIG_IPC_SOCKET="$TXING_RIG_IPC_SOCKET" \
        nohup "{{bin_dir}}/${daemon_name}" "$@" \
        >"{{run_dir}}/${daemon_name}.log" 2>&1 &
      echo "$!" >"{{run_dir}}/${daemon_name}.pid"
    }
    started_logs=""
    if [ "$sparkplug_enabled" = "true" ]; then
      start_daemon txing-sparkplug-manager
      started_logs="{{run_dir}}/txing-sparkplug-manager.log"
    else
      echo "txing-sparkplug-manager disabled by TXING_SPARKPLUG_MANAGER_ENABLED=false"
    fi
    if [ "$thread_enabled" = "true" ]; then
      sleep 1
      start_daemon txing-thread-connectivity
      started_logs="$started_logs {{run_dir}}/txing-thread-connectivity.log"
    else
      echo "txing-thread-connectivity disabled by TXING_THREAD_CONNECTIVITY_ENABLED=false"
    fi
    if [ "$ble_enabled" = "true" ]; then
      sleep 1
      start_daemon txing-ble-connectivity
      started_logs="$started_logs {{run_dir}}/txing-ble-connectivity.log"
    else
      echo "txing-ble-connectivity disabled by TXING_BLE_CONNECTIVITY_ENABLED=false"
    fi
    echo "rig daemons started"
    if [ -n "$started_logs" ]; then
      echo "logs: $started_logs"
    fi

stop:
    #!/bin/sh
    set -eu
    for name in txing-ble-connectivity txing-thread-connectivity txing-sparkplug-manager; do
      pid_file="{{run_dir}}/${name}.pid"
      if [ ! -f "$pid_file" ]; then
        continue
      fi
      pid="$(cat "$pid_file")"
      if kill -0 "$pid" >/dev/null 2>&1; then
        kill "$pid"
        wait_attempts=0
        while [ "$wait_attempts" -lt 40 ]; do
          if ! kill -0 "$pid" >/dev/null 2>&1; then
            break
          fi
          wait_attempts=$((wait_attempts + 1))
          sleep 0.25
        done
      fi
      rm -f "$pid_file"
    done
    rm -f "{{default_ipc_socket}}"
    echo "rig daemons stopped"

restart config_dir=config_dir:
    #!/bin/sh
    set -eu
    just --justfile "{{rig_dir}}/justfile" stop
    just --justfile "{{rig_dir}}/justfile" start "{{config_dir}}"

log:
    #!/bin/sh
    set -eu
    log_files=""
    for name in txing-sparkplug-manager txing-thread-connectivity txing-ble-connectivity; do
      if [ -f "{{run_dir}}/${name}.log" ]; then
        log_files="$log_files {{run_dir}}/${name}.log"
      fi
    done
    if [ -z "$log_files" ]; then
      echo "No rig daemon logs under {{run_dir}}." >&2
      exit 1
    fi
    tail -n 160 -f $log_files

check config_dir=config_dir:
    #!/bin/sh
    set -eu
    requested_config_dir="{{config_dir}}"
    requested_ipc_socket="${TXING_RIG_IPC_SOCKET:-}"
    if [ -n "$requested_config_dir" ]; then
      daemon_config_dir="$requested_config_dir"
    elif [ -n "${TXING_RIG_CONFIG_DIR:-}" ]; then
      daemon_config_dir="$TXING_RIG_CONFIG_DIR"
    else
      daemon_config_dir="$HOME/.config/txing/rig-daemon"
    fi
    daemon_env_file="$daemon_config_dir/daemon.env"
    if [ -f "$daemon_env_file" ]; then
      set -a
      . "$daemon_env_file"
      set +a
    fi
    if [ -n "$requested_ipc_socket" ]; then
      export TXING_RIG_IPC_SOCKET="$requested_ipc_socket"
    else
      export TXING_RIG_IPC_SOCKET="{{default_ipc_socket}}"
    fi
    config_bool() {
      name="$1"
      fallback="$2"
      eval "value=\${$name:-}"
      if [ -z "$value" ]; then
        value="$fallback"
      fi
      value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
      case "$value" in
        true|1|yes|on) return 0 ;;
        false|0|no|off) return 1 ;;
        *) echo "$name must be a boolean, got '$value'" >&2; exit 2 ;;
      esac
    }
    sparkplug_enabled=false
    ble_enabled=false
    thread_enabled=false
    if config_bool TXING_SPARKPLUG_MANAGER_ENABLED true; then sparkplug_enabled=true; fi
    if config_bool TXING_BLE_CONNECTIVITY_ENABLED false; then ble_enabled=true; fi
    if config_bool TXING_THREAD_CONNECTIVITY_ENABLED false; then thread_enabled=true; fi
    if [ "$sparkplug_enabled" != "true" ]; then
      if [ "$ble_enabled" = "true" ] || [ "$thread_enabled" = "true" ]; then
        echo "TXING_SPARKPLUG_MANAGER_ENABLED must be true when BLE or Thread connectivity is enabled." >&2
        exit 2
      fi
    fi
    just --justfile "{{rig_dir}}/justfile" build
    if [ "$sparkplug_enabled" = "true" ]; then
      if [ -n "$requested_config_dir" ]; then
        "{{bin_dir}}/txing-sparkplug-manager" --dry-run --config-dir "$requested_config_dir"
      else
        "{{bin_dir}}/txing-sparkplug-manager" --dry-run
      fi
    else
      echo "txing-sparkplug-manager disabled by TXING_SPARKPLUG_MANAGER_ENABLED=false"
    fi
    if [ "$thread_enabled" = "true" ]; then
      if [ -n "$requested_config_dir" ]; then
        "{{bin_dir}}/txing-thread-connectivity" --dry-run --config-dir "$requested_config_dir"
      else
        "{{bin_dir}}/txing-thread-connectivity" --dry-run
      fi
    else
      echo "txing-thread-connectivity disabled by TXING_THREAD_CONNECTIVITY_ENABLED=false"
    fi
    if [ "$ble_enabled" = "true" ]; then
      if [ -n "$requested_config_dir" ]; then
        "{{bin_dir}}/txing-ble-connectivity" --dry-run --config-dir "$requested_config_dir"
      else
        "{{bin_dir}}/txing-ble-connectivity" --dry-run
      fi
    else
      echo "txing-ble-connectivity disabled by TXING_BLE_CONNECTIVITY_ENABLED=false"
    fi

install-mise-tools:
    #!/bin/sh
    set -eu
    "{{rig_dir}}/install-mise-tools.sh"
