[private]
@_alpine-build component:
    #!/bin/sh
    set -eu

    component="{{component}}"
    project_root="{{project_root}}"
    output_root="{{docker_build_dir}}"
    output_stage="$output_root/alpine-out"
    toolchain_dir="{{static_toolchain_dir}}"
    image="{{alpine_build_image}}"
    platform="{{alpine_build_platform}}"

    case "$component" in
      daemon|kvs-master|hardware-worker|all) ;;
      *)
        echo "Unsupported unit Alpine component: $component" >&2
        exit 2
        ;;
    esac

    command -v docker >/dev/null 2>&1 || {
      echo "docker is required to build unit board projects in Alpine." >&2
      exit 1
    }
    server_platform="$(docker version --format '{{"{{"}}.Server.Os{{"}}"}}/{{"{{"}}.Server.Arch{{"}}"}}')"
    if [ "$server_platform" != "linux/arm64" ]; then
      echo "unit Alpine builds require a native linux/arm64 Docker daemon, got: $server_platform" >&2
      exit 1
    fi

    if [ "$component" = "all" ]; then
      rm -rf "$output_root"
    fi
    rm -rf "$output_stage"
    install -d "$output_stage" "$output_root/bin" "$toolchain_dir"

    docker run --rm -i \
      --platform "$platform" \
      --mount "type=bind,source=$project_root,target=$project_root,readonly" \
      --mount "type=bind,source=$output_stage,target=/out" \
      --mount "type=bind,source=$toolchain_dir,target=/toolchain" \
      -w "$project_root" \
      -e TXING_ALPINE_COMPONENT="$component" \
      -e TXING_AWS_KVS_WEBRTC_SDK_GIT_TAG="{{aws_kvs_sdk_commit}}" \
      -e TXING_BOARD_KVS_SYSTEM_CA_CERT_PATH="{{default_kvs_system_ca_cert_path}}" \
      "$image" \
      sh -se <<'ALPINE_BUILD'
    set -eu

    expected_release="3.23.5"
    actual_release="$(cat /etc/alpine-release)"
    if [ "$actual_release" != "$expected_release" ]; then
      echo "Expected Alpine $expected_release, got $actual_release" >&2
      exit 1
    fi
    if [ "$(uname -m)" != "aarch64" ]; then
      echo "Expected native aarch64 Alpine container, got $(uname -m)" >&2
      exit 1
    fi

    apk add --no-cache \
      build-base cmake pkgconf git perl ca-certificates curl \
      curl-dev openssl-dev openssl-libs-static log4cplus-dev libsrtp-dev \
      libusrsctp-dev libwebsockets-dev zlib-dev zlib-static libcamera-dev \
      linux-headers protobuf-dev protobuf grpc-dev grpc-plugins \
      go binutils file

    # Alpine gcc defaults to PIE, so -static produces a static-PIE: file says
    # 'static-pie linked' and the hard invariant is the absent PT_INTERP header.
    assert_static() {
      asserted_binary="$1"
      asserted_name="$2"
      test -x "$asserted_binary"
      file "$asserted_binary" | grep -E 'ELF 64-bit LSB.*ARM aarch64'
      file "$asserted_binary" | grep -E 'statically linked|static-pie linked'
      if readelf -l "$asserted_binary" | grep -Fq 'INTERP'; then
        echo "$asserted_name unexpectedly has an ELF interpreter (not static)" >&2
        exit 1
      fi
    }

    assert_musl_dynamic() {
      asserted_binary="$1"
      asserted_name="$2"
      test -x "$asserted_binary"
      file "$asserted_binary" | grep -E 'ELF 64-bit LSB.*ARM aarch64'
      readelf -l "$asserted_binary" | grep -F '[Requesting program interpreter: /lib/ld-musl-aarch64.so.1]'
      ldd_output="$(ldd "$asserted_binary")"
      printf '%s\n' "$ldd_output"
      if printf '%s\n' "$ldd_output" | grep -Fq 'not found'; then
        echo "$asserted_name has unresolved shared libraries" >&2
        exit 1
      fi
      printf '%s\n' "$ldd_output" | grep -F 'libc.musl-aarch64.so.1'
    }

    build_daemon() {
      daemon_source="$PWD/devices/unit/daemon"
      version_file="$PWD/release/versions/unit"
      version="$(tr -d '[:space:]' < "$version_file")"
      if ! printf '%s\n' "$version" | grep -E -q '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
        echo "release/versions/unit must contain a semantic version like x.y.z." >&2
        exit 1
      fi
      daemon_build="$(mktemp -d /tmp/txing-unit-daemon.XXXXXX)"
      (
        cd "$daemon_source"
        GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go test ./...
        GOOS=linux GOARCH=arm64 CGO_ENABLED=0 \
          go build -trimpath -buildvcs=false \
            -ldflags="-s -w -X github.com/mparkachov/txing/devices/unit/daemon/internal/daemon.DaemonVersion=$version" \
            -o "$daemon_build/txing-unit-daemon" \
            ./cmd/txing-unit-daemon
      )
      assert_static "$daemon_build/txing-unit-daemon" "txing-unit-daemon"
      "$daemon_build/txing-unit-daemon" --version
      install -m 755 "$daemon_build/txing-unit-daemon" /out/txing-unit-daemon
    }

    build_hardware_worker() {
      sh release/scripts/build-board-static-toolchain.sh /toolchain
      hardware_source="$PWD/devices/unit/board/hardware_worker"
      hardware_build="$(mktemp -d /tmp/txing-unit-hardware-worker.XXXXXX)"
      PATH="/toolchain/bin:$PATH" cmake \
        -S "$hardware_source" \
        -B "$hardware_build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=ON \
        -DTXING_HARDWARE_WORKER_GRPC=ON \
        -DCMAKE_PREFIX_PATH=/toolchain \
        -DCMAKE_EXE_LINKER_FLAGS=-static \
        -DOPENSSL_USE_STATIC_LIBS=TRUE \
        -DZLIB_USE_STATIC_LIBS=ON
      PATH="/toolchain/bin:$PATH" cmake --build "$hardware_build" --config Release
      ctest --test-dir "$hardware_build" --output-on-failure
      assert_static "$hardware_build/txing-unit-hardware-worker" "txing-unit-hardware-worker"
      "$hardware_build/txing-unit-hardware-worker" --version
      install -m 755 "$hardware_build/txing-unit-hardware-worker" /out/txing-unit-hardware-worker
    }

    build_kvs_master() {
      kvs_source="$PWD/devices/unit/board/kvs_master"
      kvs_build="$(mktemp -d /tmp/txing-unit-kvs-master.XXXXXX)"
      openssl_libdir="$(pkg-config --variable=libdir openssl)"
      openssl_includedir="$(pkg-config --variable=includedir openssl)"
      cmake \
        -S "$kvs_source" \
        -B "$kvs_build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=ON \
        -DTXING_KVS_SYSTEM_CA_CERT_PATH="$TXING_BOARD_KVS_SYSTEM_CA_CERT_PATH" \
        -DTXING_KVS_GRPC_BRIDGE=ON \
        -DTXING_AWS_KVS_WEBRTC_SDK_GIT_TAG="$TXING_AWS_KVS_WEBRTC_SDK_GIT_TAG" \
        -DOPENSSL_USE_STATIC_LIBS=FALSE \
        -DOPENSSL_INCLUDE_DIR="$openssl_includedir" \
        -DOPENSSL_SSL_LIBRARY="$openssl_libdir/libssl.so" \
        -DOPENSSL_CRYPTO_LIBRARY="$openssl_libdir/libcrypto.so"
      cmake --build "$kvs_build" --config Release
      ctest --test-dir "$kvs_build" --output-on-failure
      assert_musl_dynamic "$kvs_build/txing-unit-kvs-master" "txing-unit-kvs-master"
      kvs_ldd="$(ldd "$kvs_build/txing-unit-kvs-master")"
      printf '%s\n' "$kvs_ldd" | grep -F 'libcamera.so.0.6'
      printf '%s\n' "$kvs_ldd" | grep -F 'libcamera-base.so.0.6'
      "$kvs_build/txing-unit-kvs-master" --version
      install -m 755 "$kvs_build/txing-unit-kvs-master" /out/txing-unit-kvs-master
    }

    case "$TXING_ALPINE_COMPONENT" in
      daemon)
        build_daemon
        ;;
      kvs-master)
        build_kvs_master
        ;;
      hardware-worker)
        build_hardware_worker
        ;;
      all)
        build_daemon
        build_kvs_master
        build_hardware_worker
        ;;
    esac
    ALPINE_BUILD

    case "$component" in
      daemon)
        install -m 755 "$output_stage/txing-unit-daemon" "$output_root/bin/txing-unit-daemon"
        ;;
      kvs-master)
        install -m 755 "$output_stage/txing-unit-kvs-master" "$output_root/bin/txing-unit-kvs-master"
        ;;
      hardware-worker)
        install -m 755 "$output_stage/txing-unit-hardware-worker" "$output_root/bin/txing-unit-hardware-worker"
        ;;
      all)
        install -m 755 "$output_stage/txing-unit-daemon" "$output_root/bin/txing-unit-daemon"
        install -m 755 "$output_stage/txing-unit-kvs-master" "$output_root/bin/txing-unit-kvs-master"
        install -m 755 "$output_stage/txing-unit-hardware-worker" "$output_root/bin/txing-unit-hardware-worker"
        ;;
    esac
    rm -rf "$output_stage"


@kvs-clean:
    rm -rf "{{native_kvs_master_build_dir}}" "{{native_kvs_master_test_build_dir}}" "{{native_hardware_worker_build_dir}}" "{{native_hardware_worker_test_build_dir}}" "{{legacy_aws_kvs_sdk_build_dir}}" "{{legacy_aws_kvs_sdk_install_dir}}" "{{legacy_aws_kvs_sdk_system_deps_dir}}" "{{docker_build_dir}}" "{{static_toolchain_dir}}"

docker-build:
    #!/bin/sh
    set -eu

    for command in git jq; do
      if ! command -v "$command" >/dev/null 2>&1; then
        echo "unit daemon docker-build requires '$command'." >&2
        exit 1
      fi
    done

    just --quiet --justfile "{{daemon_justfile}}" _alpine-build all

    project_root="{{project_root}}"
    metadata_path="{{docker_build_metadata}}"
    bin_dir="{{docker_build_dir}}/bin"
    version_file="$project_root/release/versions/unit"
    version="$(tr -d '[:space:]' < "$version_file")"
    if ! printf '%s\n' "$version" | grep -E -q '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
      echo "$version_file must contain a semantic version like x.y.z." >&2
      exit 1
    fi
    commit="$(git -C "$project_root" rev-parse HEAD)"
    timestamp="$(date -u +%s)"

    jq -n \
      --arg version "$version" \
      --arg commit "$commit" \
      --argjson timestamp "$timestamp" \
      --arg daemonBinaryName "txing-unit-daemon" \
      --arg daemonBinaryPath "$bin_dir/txing-unit-daemon" \
      --arg kvsMasterBinaryName "txing-unit-kvs-master" \
      --arg kvsMasterBinaryPath "$bin_dir/txing-unit-kvs-master" \
      --arg hardwareWorkerBinaryName "txing-unit-hardware-worker" \
      --arg hardwareWorkerBinaryPath "$bin_dir/txing-unit-hardware-worker" \
      --arg projectRoot "$project_root" \
      --arg buildImage "{{alpine_build_image}}" \
      --arg buildPlatform "{{alpine_build_platform}}" \
      '{
        version: $version,
        commit: $commit,
        timestamp: $timestamp,
        outputs: {
          ($daemonBinaryName): $daemonBinaryPath,
          ($kvsMasterBinaryName): $kvsMasterBinaryPath,
          ($hardwareWorkerBinaryName): $hardwareWorkerBinaryPath
        },
        projectRoot: $projectRoot,
        buildImage: $buildImage,
        buildPlatform: $buildPlatform
      }' >"$metadata_path"

    printf 'prepared Alpine aarch64 board binaries\n'
    printf '  version: %s\n' "$version"
    printf '  commit: %s\n' "$commit"
    printf '  build image: %s\n' "{{alpine_build_image}}"
    printf '  daemon binary: %s\n' "$bin_dir/txing-unit-daemon"
    printf '  KVS master binary: %s\n' "$bin_dir/txing-unit-kvs-master"
    printf '  hardware worker binary: %s\n' "$bin_dir/txing-unit-hardware-worker"
    printf '  metadata: %s\n' "$metadata_path"

