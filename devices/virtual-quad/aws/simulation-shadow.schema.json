{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://txing.local/schemas/virtual-quad/simulation-shadow.schema.json",
  "title": "Virtual Quadcopter Simulation Named Shadow",
  "type": "object",
  "required": [
    "state"
  ],
  "properties": {
    "state": {
      "type": "object",
      "required": [
        "reported"
      ],
      "properties": {
        "reported": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "phase",
            "terminalRevision"
          ],
          "properties": {
            "controllerRevision": {
              "type": "integer",
              "minimum": 0
            },
            "phase": {
              "enum": [
                "stopped",
                "starting",
                "operational",
                "stopping",
                "failed"
              ]
            },
            "terminalRevision": {
              "type": "integer",
              "minimum": 0
            },
            "sessionId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "lastSessionId": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "lastOutcome": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "lastReason": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "availabilityWatermarkMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "availabilityExpiresAtMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "startupDeadlineMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "flightDeadlineMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "shutdownDeadlineMs": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "projectionTimestampMs": {"type": "integer", "minimum": 0},
            "receipt": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["requestId", "sequence", "redcon", "status", "reason"],
              "properties": {
                "requestId": {"type": "string", "minLength": 1},
                "sequence": {"type": "integer", "minimum": 0},
                "redcon": {"enum": [1, 4]},
                "status": {"enum": ["accepted", "succeeded", "failed"]},
                "reason": {"type": "string"}
              }
            },
            "run": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": [
                "owner", "townId", "rigId", "startRequestId", "startSequence",
                "hardDeadlineMs", "simulation", "mavlink", "video"
              ],
              "properties": {
                "owner": {"type": "string", "minLength": 1},
                "townId": {"type": "string", "minLength": 1},
                "rigId": {"type": "string", "minLength": 1},
                "startRequestId": {"type": "string", "minLength": 1},
                "startSequence": {"type": "integer", "minimum": 0},
                "stopRequestId": {"type": "string"},
                "stopSequence": {"type": "integer", "minimum": 0},
                "hardDeadlineMs": {"type": "integer", "minimum": 1},
                "simulation": {"type": "boolean"},
                "mavlink": {"type": "boolean"},
                "video": {"type": "boolean"},
                "readinessLostAtMs": {"type": ["integer", "null"], "minimum": 0}
              }
            }
          }
        }
      }
    }
  }
}
