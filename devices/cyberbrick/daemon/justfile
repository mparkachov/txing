set shell := ["sh", "-eu", "-c"]
set quiet := true

daemon_dir := source_directory()
project_root := canonicalize(daemon_dir + "/../../..")
tmp_dir := project_root + "/tmp"
export TMPDIR := tmp_dir
export GOPATH := tmp_dir + "/go/gopath"
export GOMODCACHE := tmp_dir + "/go/gopath/pkg/mod"
export GOCACHE := tmp_dir + "/go/build"

root_justfile := project_root + "/justfile"
daemon_justfile := daemon_dir + "/justfile"
aws_lib := project_root + "/shared/aws/scripts/aws_lib.sh"
cyberbrick_board_dir := project_root + "/devices/cyberbrick/board"
native_kvs_master_dir := cyberbrick_board_dir + "/kvs_master"
native_kvs_master_test_build_dir := native_kvs_master_dir + "/build-tests"
native_hardware_worker_dir := cyberbrick_board_dir + "/hardware_worker"
native_hardware_worker_test_build_dir := native_hardware_worker_dir + "/build-tests"
aws_kvs_sdk_commit := "bb106510cf74edd2c24881c1ae94ceaa0083d15c"
default_kvs_system_ca_cert_path := env_var_or_default("TXING_BOARD_KVS_SYSTEM_CA_CERT_PATH", "/etc/ssl/certs/ca-certificates.crt")

alpine_build_image := "docker.io/library/alpine:3.23.5"
alpine_build_platform := "linux/arm64"
docker_build_dir := daemon_dir + "/target/docker-build"
docker_build_metadata := docker_build_dir + "/metadata.json"

role-policy thing_id='':
    #!/bin/sh
    set -eu
    requested_thing_name="{{thing_id}}"
    case "$requested_thing_name" in *=*) echo "Do not pass just recipe arguments as name=value. Use: just cyberbrick::daemon::role-policy <thing-id>" >&2; exit 2 ;; esac
    if [ -n "$requested_thing_name" ]; then
      export TXING_THING_ID="$requested_thing_name"
    fi
    . "{{aws_lib}}"
    eval "$(just --justfile "{{root_justfile}}" _project-aws-env device)"
    txing_aws_init
    effective_thing_name="${requested_thing_name:-$THING_NAME}"
    case "$effective_thing_name" in *=*) echo "Invalid Thing ID '$effective_thing_name'. Use positional just arguments, for example: just cyberbrick::daemon::role-policy cyberbrick-bl95f2" >&2; exit 2 ;; esac
    if ! printf '%s\n' "$effective_thing_name" | grep -E -q '^[a-zA-Z0-9:_-]+$'; then
      echo "Invalid Thing ID '$effective_thing_name'. Allowed characters: letters, digits, colon, underscore, hyphen." >&2
      exit 2
    fi
    account_id="$(aws sts get-caller-identity --query Account --output text)"
    caller_arn="$(aws sts get-caller-identity --query Arn --output text)"
    partition="$(printf '%s\n' "$caller_arn" | cut -d: -f2)"
    daemon_role_name="txing-daemon-$effective_thing_name"
    if ! aws iam get-role --role-name "$daemon_role_name" >/dev/null 2>&1; then
      echo "Daemon IAM role $daemon_role_name does not exist. Run just aws::cert <thing-id> first." >&2
      exit 1
    fi
    cloudwatch_log_group="txing/${TXING_TOWN_ID}/${TXING_RIG_ID}/${effective_thing_name}"
    credential_policy_file="$(mktemp "${TMPDIR:-/tmp}/txing-daemon-credential-policy.XXXXXX")"
    cleanup() {
      rm -f "$credential_policy_file"
    }
    trap cleanup EXIT
    jq -n \
      --arg iotShadowArn "arn:${partition}:iot:${TXING_AWS_REGION}:${account_id}:thing/${effective_thing_name}/sparkplug" \
      --arg cloudwatchLogGroupArn "arn:${partition}:logs:${TXING_AWS_REGION}:${account_id}:log-group:${cloudwatch_log_group}" \
      --arg cloudwatchLogStreamArn "arn:${partition}:logs:${TXING_AWS_REGION}:${account_id}:log-group:${cloudwatch_log_group}:log-stream:*" \
      --arg kvsChannelArn "arn:${partition}:kinesisvideo:${TXING_AWS_REGION}:${account_id}:channel/${effective_thing_name}-board-video/*" \
      '{Version: "2012-10-17", Statement: [
        {Sid: "DaemonSparkplugShadowRead", Effect: "Allow", Action: "iot:GetThingShadow", Resource: $iotShadowArn},
        {Sid: "DaemonCloudWatchLogsWrite", Effect: "Allow", Action: ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:DescribeLogStreams", "logs:PutRetentionPolicy", "logs:PutLogEvents"], Resource: [$cloudwatchLogGroupArn, $cloudwatchLogStreamArn]},
        {Sid: "DaemonBoardVideoMaster", Effect: "Allow", Action: ["kinesisvideo:DescribeSignalingChannel", "kinesisvideo:GetSignalingChannelEndpoint", "kinesisvideo:GetIceServerConfig", "kinesisvideo:ConnectAsMaster"], Resource: $kvsChannelArn}
      ]}' \
      >"$credential_policy_file"
    aws iam put-role-policy \
      --role-name "$daemon_role_name" \
      --policy-name txing-daemon-own-thing \
      --policy-document "file://$credential_policy_file"
    printf 'refreshed daemon IAM role policy\n'
    printf '  thing: %s\n' "$effective_thing_name"
    printf '  role: %s\n' "$daemon_role_name"
    printf '  video region: %s\n' "$TXING_AWS_REGION"

test:
    cd "{{daemon_dir}}" && go test ./...

run:
    cd "{{daemon_dir}}" && go run ./cmd/txing-cyberbrick-daemon

@kvs-test-native:
    cmake -S "{{native_kvs_master_dir}}" -B "{{native_kvs_master_test_build_dir}}" -DCMAKE_BUILD_TYPE=Debug -DTXING_KVS_REAL_SDK=OFF -DTXING_KVS_SYSTEM_CA_CERT_PATH="{{default_kvs_system_ca_cert_path}}"
    cmake --build "{{native_kvs_master_test_build_dir}}" --config Debug --target txing-cyberbrick-kvs-master-tests
    ctest --test-dir "{{native_kvs_master_test_build_dir}}" --output-on-failure

@hardware-test-native:
    cmake -S "{{native_hardware_worker_dir}}" -B "{{native_hardware_worker_test_build_dir}}" -DCMAKE_BUILD_TYPE=Debug -DTXING_HARDWARE_WORKER_GRPC=OFF
    cmake --build "{{native_hardware_worker_test_build_dir}}" --config Debug --target txing-cyberbrick-hardware-worker-tests
    ctest --test-dir "{{native_hardware_worker_test_build_dir}}" --output-on-failure

@daemon-build-alpine:
    just --quiet --justfile "{{daemon_justfile}}" _alpine-build daemon

@kvs-build-alpine:
    just --quiet --justfile "{{daemon_justfile}}" _alpine-build kvs-master

@hardware-build-alpine:
    just --quiet --justfile "{{daemon_justfile}}" _alpine-build hardware-worker

docker-build:
    #!/bin/sh
    set -eu

    just --quiet --justfile "{{daemon_justfile}}" _alpine-build all

    project_root="{{project_root}}"
    metadata_path="{{docker_build_metadata}}"
    bin_dir="{{docker_build_dir}}/bin"
    version="$(awk -F '"' '/packageVersion =/ { print $2; exit }' "{{daemon_dir}}/internal/daemon/version.go")"
    commit="$(git -C "$project_root" rev-parse HEAD)"
    timestamp="$(date -u +%s)"

    for command in git jq; do
      if ! command -v "$command" >/dev/null 2>&1; then
        echo "cyberbrick daemon docker-build requires '$command'." >&2
        exit 1
      fi
    done
    if ! printf '%s\n' "$version" | grep -E -q '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
      echo "Cyberbrick daemon packageVersion must contain a semantic version like x.y.z." >&2
      exit 1
    fi

    jq -n \
      --arg version "$version" \
      --arg commit "$commit" \
      --argjson timestamp "$timestamp" \
      --arg daemonBinaryName "txing-cyberbrick-daemon" \
      --arg daemonBinaryPath "$bin_dir/txing-cyberbrick-daemon" \
      --arg kvsMasterBinaryName "txing-cyberbrick-kvs-master" \
      --arg kvsMasterBinaryPath "$bin_dir/txing-cyberbrick-kvs-master" \
      --arg hardwareWorkerBinaryName "txing-cyberbrick-hardware-worker" \
      --arg hardwareWorkerBinaryPath "$bin_dir/txing-cyberbrick-hardware-worker" \
      --arg projectRoot "$project_root" \
      --arg buildImage "{{alpine_build_image}}" \
      --arg buildPlatform "{{alpine_build_platform}}" \
      '{
        version: $version,
        commit: $commit,
        timestamp: $timestamp,
        outputs: {
          ($daemonBinaryName): $daemonBinaryPath,
          ($kvsMasterBinaryName): $kvsMasterBinaryPath,
          ($hardwareWorkerBinaryName): $hardwareWorkerBinaryPath
        },
        projectRoot: $projectRoot,
        buildImage: $buildImage,
        buildPlatform: $buildPlatform
      }' >"$metadata_path"

    printf 'prepared Alpine aarch64 board binaries\n'
    printf '  version: %s\n' "$version"
    printf '  build image: %s\n' "{{alpine_build_image}}"
    printf '  daemon binary: %s\n' "$bin_dir/txing-cyberbrick-daemon"
    printf '  KVS master binary: %s\n' "$bin_dir/txing-cyberbrick-kvs-master"
    printf '  hardware worker binary: %s\n' "$bin_dir/txing-cyberbrick-hardware-worker"
    printf '  metadata: %s\n' "$metadata_path"

[private]
@_alpine-build component:
    #!/bin/sh
    set -eu

    component="{{component}}"
    project_root="{{project_root}}"
    output_root="{{docker_build_dir}}"
    output_stage="$output_root/alpine-out"
    image="{{alpine_build_image}}"
    platform="{{alpine_build_platform}}"

    case "$component" in
      daemon|kvs-master|hardware-worker|all) ;;
      *)
        echo "Unsupported Cyberbrick Alpine component: $component" >&2
        exit 2
        ;;
    esac

    command -v docker >/dev/null 2>&1 || {
      echo "docker is required to build Cyberbrick board projects in Alpine." >&2
      exit 1
    }
    server_platform="$(docker version --format '{{"{{"}}.Server.Os{{"}}"}}/{{"{{"}}.Server.Arch{{"}}"}}')"
    if [ "$server_platform" != "linux/arm64" ]; then
      echo "Cyberbrick Alpine builds require a native linux/arm64 Docker daemon, got: $server_platform" >&2
      exit 1
    fi

    if [ "$component" = "all" ]; then
      rm -rf "$output_root"
    fi
    rm -rf "$output_stage"
    install -d "$output_stage" "$output_root/bin"

    docker run --rm -i \
      --platform "$platform" \
      --mount "type=bind,source=$project_root,target=$project_root,readonly" \
      --mount "type=bind,source=$output_stage,target=/out" \
      -w "$project_root" \
      -e TXING_ALPINE_COMPONENT="$component" \
      -e TXING_AWS_KVS_WEBRTC_SDK_GIT_TAG="{{aws_kvs_sdk_commit}}" \
      -e TXING_BOARD_KVS_SYSTEM_CA_CERT_PATH="{{default_kvs_system_ca_cert_path}}" \
      "$image" \
      sh -se <<'ALPINE_BUILD'
    set -eu

    expected_release="3.23.5"
    actual_release="$(cat /etc/alpine-release)"
    if [ "$actual_release" != "$expected_release" ]; then
      echo "Expected Alpine $expected_release, got $actual_release" >&2
      exit 1
    fi
    if [ "$(uname -m)" != "aarch64" ]; then
      echo "Expected native aarch64 Alpine container, got $(uname -m)" >&2
      exit 1
    fi

    apk add --no-cache \
      build-base cmake pkgconf git perl ca-certificates \
      curl-dev openssl-dev log4cplus-dev libsrtp-dev libusrsctp-dev \
      libwebsockets-dev zlib-dev libcamera-dev linux-headers \
      protobuf-dev protobuf grpc-dev grpc-plugins \
      go binutils file

    assert_musl_dynamic() {
      asserted_binary="$1"
      asserted_name="$2"
      test -x "$asserted_binary"
      file "$asserted_binary" | grep -E 'ELF 64-bit LSB.*ARM aarch64'
      readelf -l "$asserted_binary" | grep -F '[Requesting program interpreter: /lib/ld-musl-aarch64.so.1]'
      ldd_output="$(ldd "$asserted_binary")"
      printf '%s\n' "$ldd_output"
      if printf '%s\n' "$ldd_output" | grep -Fq 'not found'; then
        echo "$asserted_name has unresolved shared libraries" >&2
        exit 1
      fi
      printf '%s\n' "$ldd_output" | grep -F 'libc.musl-aarch64.so.1'
    }

    build_daemon() {
      daemon_source="$PWD/devices/cyberbrick/daemon"
      daemon_build="$(mktemp -d /tmp/txing-cyberbrick-daemon.XXXXXX)"
      (
        cd "$daemon_source"
        go test ./...
        CGO_ENABLED=1 GOOS=linux GOARCH=arm64 \
          go build -trimpath \
            -ldflags='-linkmode=external -s -w' \
            -o "$daemon_build/txing-cyberbrick-daemon" \
            ./cmd/txing-cyberbrick-daemon
      )
      assert_musl_dynamic "$daemon_build/txing-cyberbrick-daemon" "txing-cyberbrick-daemon"
      "$daemon_build/txing-cyberbrick-daemon" --version
      install -m 755 "$daemon_build/txing-cyberbrick-daemon" /out/txing-cyberbrick-daemon
    }

    build_hardware_worker() {
      hardware_source="$PWD/devices/cyberbrick/board/hardware_worker"
      hardware_build="$(mktemp -d /tmp/txing-cyberbrick-hardware-worker.XXXXXX)"
      cmake \
        -S "$hardware_source" \
        -B "$hardware_build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=ON \
        -DTXING_HARDWARE_WORKER_GRPC=ON
      cmake --build "$hardware_build" --config Release
      ctest --test-dir "$hardware_build" --output-on-failure
      assert_musl_dynamic "$hardware_build/txing-cyberbrick-hardware-worker" "txing-cyberbrick-hardware-worker"
      "$hardware_build/txing-cyberbrick-hardware-worker" --version
      install -m 755 "$hardware_build/txing-cyberbrick-hardware-worker" /out/txing-cyberbrick-hardware-worker
    }

    build_kvs_master() {
      kvs_source="$PWD/devices/cyberbrick/board/kvs_master"
      kvs_build="$(mktemp -d /tmp/txing-cyberbrick-kvs-master.XXXXXX)"
      openssl_libdir="$(pkg-config --variable=libdir openssl)"
      openssl_includedir="$(pkg-config --variable=includedir openssl)"
      cmake \
        -S "$kvs_source" \
        -B "$kvs_build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=ON \
        -DTXING_KVS_SYSTEM_CA_CERT_PATH="$TXING_BOARD_KVS_SYSTEM_CA_CERT_PATH" \
        -DTXING_KVS_GRPC_BRIDGE=ON \
        -DTXING_AWS_KVS_WEBRTC_SDK_GIT_TAG="$TXING_AWS_KVS_WEBRTC_SDK_GIT_TAG" \
        -DOPENSSL_USE_STATIC_LIBS=FALSE \
        -DOPENSSL_INCLUDE_DIR="$openssl_includedir" \
        -DOPENSSL_SSL_LIBRARY="$openssl_libdir/libssl.so" \
        -DOPENSSL_CRYPTO_LIBRARY="$openssl_libdir/libcrypto.so"
      cmake --build "$kvs_build" --config Release
      ctest --test-dir "$kvs_build" --output-on-failure
      assert_musl_dynamic "$kvs_build/txing-cyberbrick-kvs-master" "txing-cyberbrick-kvs-master"
      kvs_ldd="$(ldd "$kvs_build/txing-cyberbrick-kvs-master")"
      printf '%s\n' "$kvs_ldd" | grep -F 'libcamera.so.0.6'
      printf '%s\n' "$kvs_ldd" | grep -F 'libcamera-base.so.0.6'
      "$kvs_build/txing-cyberbrick-kvs-master" --version
      install -m 755 "$kvs_build/txing-cyberbrick-kvs-master" /out/txing-cyberbrick-kvs-master
    }

    case "$TXING_ALPINE_COMPONENT" in
      daemon)
        build_daemon
        ;;
      kvs-master)
        build_kvs_master
        ;;
      hardware-worker)
        build_hardware_worker
        ;;
      all)
        build_daemon
        build_kvs_master
        build_hardware_worker
        ;;
    esac
    ALPINE_BUILD

    case "$component" in
      daemon)
        install -m 755 "$output_stage/txing-cyberbrick-daemon" "$output_root/bin/txing-cyberbrick-daemon"
        ;;
      kvs-master)
        install -m 755 "$output_stage/txing-cyberbrick-kvs-master" "$output_root/bin/txing-cyberbrick-kvs-master"
        ;;
      hardware-worker)
        install -m 755 "$output_stage/txing-cyberbrick-hardware-worker" "$output_root/bin/txing-cyberbrick-hardware-worker"
        ;;
      all)
        install -m 755 "$output_stage/txing-cyberbrick-daemon" "$output_root/bin/txing-cyberbrick-daemon"
        install -m 755 "$output_stage/txing-cyberbrick-kvs-master" "$output_root/bin/txing-cyberbrick-kvs-master"
        install -m 755 "$output_stage/txing-cyberbrick-hardware-worker" "$output_root/bin/txing-cyberbrick-hardware-worker"
        ;;
    esac
    rm -rf "$output_stage"

@clean:
    rm -rf "{{native_kvs_master_test_build_dir}}" "{{native_hardware_worker_test_build_dir}}" "{{docker_build_dir}}"
