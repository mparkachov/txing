+uint32_t RCOutput_Sysfs::brushed_duty_cycle(uint16_t output_us,
+                                             uint16_t minimum_us,
+                                             uint16_t maximum_us,
+                                             uint32_t period_ns)
+{
+    if (output_us <= minimum_us) {
+        return 0;
+    }
+    if (output_us >= maximum_us || maximum_us <= minimum_us) {
+        return period_ns;
+    }
+    return static_cast<uint32_t>((static_cast<uint64_t>(period_ns) *
+                                  (output_us - minimum_us)) /
+                                 (maximum_us - minimum_us));
+}
+
+bool RCOutput_Sysfs::is_brushed(uint8_t ch) const
+{
+    return ch < _channel_count && (_brushed_mask & (1U << ch));
+}
+
+void RCOutput_Sysfs::replace_pwm_channel_for_test(uint8_t ch, PWM_Sysfs_Base *channel)
+{
+    if (ch >= _channel_count || _pwm_channels == nullptr) {
+        delete channel;
+        return;
+    }
+    delete _pwm_channels[ch];
+    _pwm_channels[ch] = channel;
+}
+
+bool RCOutput_Sysfs::set_duty_cycle(uint8_t ch, uint16_t output_us)
+{
+    if (ch >= _channel_count || _pwm_channels[ch] == nullptr) {
+        return false;
+    }
+    const uint32_t duty_ns = is_brushed(ch) ?
+        brushed_duty_cycle(output_us, _esc_pwm_min, _esc_pwm_max,
+                           _pwm_channels[ch]->get_period()) :
+        usec_to_nsec(output_us);
+    return _pwm_channels[ch]->set_duty_cycle(duty_ns);
+}
+
+bool RCOutput_Sysfs::neutralize_all()
+{
+    bool success = true;
+    if (_pwm_channels == nullptr) {
+        return false;
+    }
+    for (uint8_t i = 0; i < _channel_count; i++) {
+        if (_pwm_channels[i] == nullptr) {
+            continue;
+        }
+        success &= _pwm_channels[i]->set_duty_cycle(0);
+        _pwm_channels[i]->enable(false);
+    }
+    return success;
+}
+
+void RCOutput_Sysfs::fail(const char *operation)
+{
+    neutralize_all();
+    AP_HAL::panic("RCOutput_Sysfs: failed to %s", operation);
+}
     
 }
     
