+uint32_t RCOutput_Sysfs::brushed_duty_cycle(uint16_t output_us,
+                                             uint16_t minimum_us,
+                                             uint16_t maximum_us,
+                                             uint32_t period_ns,
+                                             const BrushedMotorEnvelope &envelope)
+{
+    if (output_us <= minimum_us || !valid_brushed_motor_envelope(envelope) ||
+        maximum_us <= minimum_us) {
+        return 0;
+    }
+
+    uint32_t raw_output = envelope.cmd_raw_max_speed;
+    if (output_us < maximum_us) {
+        const uint64_t input_range = maximum_us - minimum_us;
+        const uint64_t raw_range = envelope.cmd_raw_max_speed - envelope.cmd_raw_min_speed;
+        const uint64_t scaled_raw =
+            (static_cast<uint64_t>(output_us - minimum_us) * raw_range + input_range / 2U) /
+            input_range;
+        raw_output = envelope.cmd_raw_min_speed + static_cast<uint32_t>(scaled_raw);
+    }
+
+    const uint64_t duty = static_cast<uint64_t>(raw_output) * period_ns;
+    return static_cast<uint32_t>((duty + envelope.raw_max_speed / 2U) /
+                                 envelope.raw_max_speed);
+}
+
+bool RCOutput_Sysfs::parse_brushed_motor_envelope(const char *raw_max_speed,
+                                                   const char *cmd_raw_min_speed,
+                                                   const char *cmd_raw_max_speed,
+                                                   BrushedMotorEnvelope &envelope)
+{
+    const auto parse_u32 = [](const char *value, uint32_t &parsed) {
+        if (value == nullptr || *value == '\0') {
+            return false;
+        }
+        for (const char *cursor = value; *cursor != '\0'; ++cursor) {
+            if (*cursor < '0' || *cursor > '9') {
+                return false;
+            }
+        }
+
+        errno = 0;
+        char *end = nullptr;
+        const unsigned long long number = std::strtoull(value, &end, 10);
+        if (errno == ERANGE || end == value || *end != '\0' ||
+            number > std::numeric_limits<uint32_t>::max()) {
+            return false;
+        }
+        parsed = static_cast<uint32_t>(number);
+        return true;
+    };
+
+    BrushedMotorEnvelope candidate{};
+    if (!parse_u32(raw_max_speed, candidate.raw_max_speed) ||
+        !parse_u32(cmd_raw_min_speed, candidate.cmd_raw_min_speed) ||
+        !parse_u32(cmd_raw_max_speed, candidate.cmd_raw_max_speed) ||
+        !valid_brushed_motor_envelope(candidate)) {
+        return false;
+    }
+
+    envelope = candidate;
+    return true;
+}
+
+bool RCOutput_Sysfs::valid_brushed_motor_envelope(const BrushedMotorEnvelope &envelope)
+{
+    return envelope.raw_max_speed > 0 &&
+        envelope.cmd_raw_max_speed > 0 &&
+        envelope.cmd_raw_min_speed < envelope.cmd_raw_max_speed &&
+        envelope.cmd_raw_max_speed <= envelope.raw_max_speed;
+}
+
+bool RCOutput_Sysfs::load_brushed_motor_envelope()
+{
+    return parse_brushed_motor_envelope(
+        std::getenv("TXING_MOTOR_RAW_MAX_SPEED"),
+        std::getenv("TXING_MOTOR_CMD_RAW_MIN_SPEED"),
+        std::getenv("TXING_MOTOR_CMD_RAW_MAX_SPEED"),
+        _brushed_motor_envelope
+    );
+}
+
+bool RCOutput_Sysfs::is_brushed(uint8_t ch) const
+{
+    return ch < _channel_count && (_brushed_mask & (1U << ch));
+}
+
+void RCOutput_Sysfs::replace_pwm_channel_for_test(uint8_t ch, PWM_Sysfs_Base *channel)
+{
+    if (ch >= _channel_count || _pwm_channels == nullptr) {
+        delete channel;
+        return;
+    }
+    delete _pwm_channels[ch];
+    _pwm_channels[ch] = channel;
+}
+
+bool RCOutput_Sysfs::set_brushed_motor_envelope_for_test(const BrushedMotorEnvelope &envelope)
+{
+    if (!valid_brushed_motor_envelope(envelope)) {
+        return false;
+    }
+    _brushed_motor_envelope = envelope;
+    return true;
+}
+
+bool RCOutput_Sysfs::set_duty_cycle(uint8_t ch, uint16_t output_us)
+{
+    if (ch >= _channel_count || _pwm_channels[ch] == nullptr) {
+        return false;
+    }
+    const uint32_t duty_ns = is_brushed(ch) ?
+        brushed_duty_cycle(output_us, _esc_pwm_min, _esc_pwm_max,
+                           _pwm_channels[ch]->get_period(), _brushed_motor_envelope) :
+        usec_to_nsec(output_us);
+    return _pwm_channels[ch]->set_duty_cycle(duty_ns);
+}
+
+bool RCOutput_Sysfs::neutralize_all()
+{
+    bool success = true;
+    if (_pwm_channels == nullptr) {
+        return false;
+    }
+    for (uint8_t i = 0; i < _channel_count; i++) {
+        if (_pwm_channels[i] == nullptr) {
+            continue;
+        }
+        success &= _pwm_channels[i]->set_duty_cycle(0);
+        _pwm_channels[i]->enable(false);
+    }
+    return success;
+}
+
+void RCOutput_Sysfs::fail(const char *operation)
+{
+    neutralize_all();
+    AP_HAL::panic("RCOutput_Sysfs: failed to %s", operation);
+}
     
 }
     
