diff --git a/libraries/AP_HAL_Linux/tests/test_rcoutput_sysfs_brushed.cpp b/libraries/AP_HAL_Linux/tests/test_rcoutput_sysfs_brushed.cpp
new file mode 100644
index 0000000000..e0e7564113
--- /dev/null
+++ b/libraries/AP_HAL_Linux/tests/test_rcoutput_sysfs_brushed.cpp
@@ -0,0 +1,126 @@
+#include <AP_gtest.h>
+
+#include <AP_HAL_Linux/RCOutput_Sysfs.h>
+
+using namespace Linux;
+
+const AP_HAL::HAL& hal = AP_HAL::get_HAL();
+
+class TestRCOutputSysfs : public RCOutput_Sysfs {
+public:
+    using RCOutput_Sysfs::RCOutput_Sysfs;
+    using RCOutput_Sysfs::is_brushed;
+    using RCOutput_Sysfs::replace_pwm_channel_for_test;
+    using RCOutput_Sysfs::set_brushed_motor_envelope_for_test;
+};
+
+class FakePWM final : public PWM_Sysfs_Base {
+public:
+    explicit FakePWM(uint32_t period)
+        : PWM_Sysfs_Base(nullptr, nullptr, nullptr, nullptr, nullptr, 0)
+        , period_ns(period)
+    {
+    }
+
+    void enable(bool value) override { enabled = value; }
+    uint32_t get_period() override { return period_ns; }
+    void set_freq(uint32_t frequency_hz) override { frequency = frequency_hz; }
+    uint32_t get_freq() override { return frequency; }
+    bool set_duty_cycle(uint32_t value) override
+    {
+        duty_cycle_ns = value;
+        return true;
+    }
+    uint32_t get_duty_cycle() override { return duty_cycle_ns; }
+
+    uint32_t period_ns;
+    uint32_t frequency = 0;
+    uint32_t duty_cycle_ns = 0;
+    bool enabled = true;
+};
+
+TEST(RCOutputSysfs, brushed_duty_cycle_applies_the_tbot_envelope)
+{
+    constexpr uint32_t period_ns = 62500;
+    const RCOutput_Sysfs::BrushedMotorEnvelope envelope{480, 100, 200};
+
+    EXPECT_EQ(RCOutput_Sysfs::brushed_duty_cycle(999, 1000, 2000, period_ns, envelope), 0U);
+    EXPECT_EQ(RCOutput_Sysfs::brushed_duty_cycle(1000, 1000, 2000, period_ns, envelope), 0U);
+    EXPECT_EQ(RCOutput_Sysfs::brushed_duty_cycle(1001, 1000, 2000, period_ns, envelope), 13021U);
+    EXPECT_EQ(RCOutput_Sysfs::brushed_duty_cycle(1500, 1000, 2000, period_ns, envelope), 19531U);
+    EXPECT_EQ(RCOutput_Sysfs::brushed_duty_cycle(2000, 1000, 2000, period_ns, envelope), 26042U);
+    EXPECT_EQ(RCOutput_Sysfs::brushed_duty_cycle(2001, 1000, 2000, period_ns, envelope), 26042U);
+}
+
+TEST(RCOutputSysfs, brushed_duty_cycle_applies_an_alternate_envelope)
+{
+    constexpr uint32_t period_ns = 100000;
+    const RCOutput_Sysfs::BrushedMotorEnvelope envelope{1000, 200, 400};
+
+    EXPECT_EQ(RCOutput_Sysfs::brushed_duty_cycle(1001, 1000, 2000, period_ns, envelope), 20000U);
+    EXPECT_EQ(RCOutput_Sysfs::brushed_duty_cycle(1500, 1000, 2000, period_ns, envelope), 30000U);
+    EXPECT_EQ(RCOutput_Sysfs::brushed_duty_cycle(2000, 1000, 2000, period_ns, envelope), 40000U);
+}
+
+TEST(RCOutputSysfs, brushed_motor_envelope_requires_valid_unsigned_values)
+{
+    RCOutput_Sysfs::BrushedMotorEnvelope envelope{};
+
+    EXPECT_TRUE(RCOutput_Sysfs::parse_brushed_motor_envelope("480", "100", "200", envelope));
+    EXPECT_EQ(envelope.raw_max_speed, 480U);
+    EXPECT_EQ(envelope.cmd_raw_min_speed, 100U);
+    EXPECT_EQ(envelope.cmd_raw_max_speed, 200U);
+
+    EXPECT_FALSE(RCOutput_Sysfs::parse_brushed_motor_envelope(nullptr, "100", "200", envelope));
+    EXPECT_FALSE(RCOutput_Sysfs::parse_brushed_motor_envelope("480", "", "200", envelope));
+    EXPECT_FALSE(RCOutput_Sysfs::parse_brushed_motor_envelope("480", "abc", "200", envelope));
+    EXPECT_FALSE(RCOutput_Sysfs::parse_brushed_motor_envelope("480", "-1", "200", envelope));
+    EXPECT_FALSE(RCOutput_Sysfs::parse_brushed_motor_envelope("0", "0", "1", envelope));
+    EXPECT_FALSE(RCOutput_Sysfs::parse_brushed_motor_envelope("480", "200", "200", envelope));
+    EXPECT_FALSE(RCOutput_Sysfs::parse_brushed_motor_envelope("480", "100", "481", envelope));
+}
+
+TEST(RCOutputSysfs, brushed_mode_tracks_each_output_channel)
+{
+    TestRCOutputSysfs output(0, 0, 2);
+
+    output.set_output_mode(1U << 0, AP_HAL::RCOutput::MODE_PWM_BRUSHED);
+    EXPECT_TRUE(output.is_brushed(0));
+    EXPECT_FALSE(output.is_brushed(1));
+
+    output.set_output_mode(1U << 1, AP_HAL::RCOutput::MODE_PWM_BRUSHED);
+    EXPECT_TRUE(output.is_brushed(0));
+    EXPECT_TRUE(output.is_brushed(1));
+
+    output.set_output_mode(1U << 0, AP_HAL::RCOutput::MODE_PWM_NORMAL);
+    EXPECT_FALSE(output.is_brushed(0));
+    EXPECT_TRUE(output.is_brushed(1));
+}
+
+TEST(RCOutputSysfs, frequency_mask_and_safety_apply_to_the_selected_channels)
+{
+    TestRCOutputSysfs output(0, 0, 2);
+    auto *left = new FakePWM(62500);
+    auto *right = new FakePWM(62500);
+    output.replace_pwm_channel_for_test(0, left);
+    output.replace_pwm_channel_for_test(1, right);
+
+    output.set_freq(1U << 1, 16000);
+    EXPECT_EQ(left->frequency, 0U);
+    EXPECT_EQ(right->frequency, 16000U);
+
+    ASSERT_TRUE(output.set_brushed_motor_envelope_for_test({480, 100, 200}));
+    output.set_output_mode((1U << 0) | (1U << 1), AP_HAL::RCOutput::MODE_PWM_BRUSHED);
+    output.write(0, 2000);
+    output.write(1, 1500);
+    EXPECT_EQ(left->duty_cycle_ns, 26042U);
+    EXPECT_EQ(right->duty_cycle_ns, 19531U);
+
+    EXPECT_TRUE(output.force_safety_on());
+    EXPECT_EQ(left->duty_cycle_ns, 0U);
+    EXPECT_EQ(right->duty_cycle_ns, 0U);
+    EXPECT_FALSE(left->enabled);
+    EXPECT_FALSE(right->enabled);
+}
+
+AP_GTEST_MAIN()
