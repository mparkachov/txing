+
+GPIO_TBot::~GPIO_TBot()
+{
+    for (const int line_fd : _line_fds) {
+        if (line_fd >= 0) {
+            ::close(line_fd);
+        }
+    }
+    if (_chip_fd >= 0) {
+        ::close(_chip_fd);
+    }
+}
+
+bool GPIO_TBot::valid_pin(uint8_t pin) const
+{
+    return pin < _line_fds.size();
+}
+
+void GPIO_TBot::init()
+{
+    char path[32];
+    const int length = snprintf(path, sizeof(path), "/dev/gpiochip%u",
+                                HAL_LINUX_GPIO_TBOT_CHIP);
+    if (length < 0 || static_cast<size_t>(length) >= sizeof(path)) {
+        AP_HAL::panic("GPIO_TBot: invalid gpiochip path");
+        return;
+    }
+
+    _chip_fd = ::open(path, O_RDONLY | O_CLOEXEC);
+    if (_chip_fd < 0) {
+        AP_HAL::panic("GPIO_TBot: unable to open %s: %s", path, strerror(errno));
+    }
+}
+
+void GPIO_TBot::pinMode(uint8_t pin, uint8_t output)
+{
+    if (!valid_pin(pin)) {
+        AP_HAL::panic("GPIO_TBot: BCM pin %u is out of range", pin);
+        return;
+    }
+    if (output != HAL_GPIO_OUTPUT) {
+        AP_HAL::panic("GPIO_TBot: BCM pin %u only supports output mode", pin);
+        return;
+    }
+    if (_chip_fd < 0) {
+        AP_HAL::panic("GPIO_TBot: gpiochip is not open");
+        return;
+    }
+    if (_line_fds[pin] >= 0) {
+        return;
+    }
+
+    gpiohandle_request request{};
+    request.lineoffsets[0] = pin;
+    request.flags = GPIOHANDLE_REQUEST_OUTPUT;
+    request.default_values[0] = 0;
+    request.lines = 1;
+    snprintf(request.consumer_label, sizeof(request.consumer_label),
+             "ardupilot-tbot");
+    if (ioctl(_chip_fd, GPIO_GET_LINEHANDLE_IOCTL, &request) < 0) {
+        AP_HAL::panic("GPIO_TBot: request BCM pin %u from gpiochip%u: %s",
+                      pin, HAL_LINUX_GPIO_TBOT_CHIP, strerror(errno));
+        return;
+    }
+
+    _line_fds[pin] = request.fd;
+    _values[pin] = 0;
+}
+
+void GPIO_TBot::pinMode(uint8_t pin, uint8_t output, uint8_t alt)
+{
+    if (output == HAL_GPIO_OUTPUT) {
+        pinMode(pin, output);
+        return;
+    }
+    AP_HAL::panic("GPIO_TBot: BCM pin %u does not support alternate mode %u",
+                  pin, alt);
+}
+
+uint8_t GPIO_TBot::read(uint8_t pin)
+{
+    if (!valid_pin(pin) || _line_fds[pin] < 0) {
+        AP_HAL::panic("GPIO_TBot: BCM pin %u is not an output", pin);
+        return 0;
+    }
+
+    gpiohandle_data data{};
+    if (ioctl(_line_fds[pin], GPIOHANDLE_GET_LINE_VALUES_IOCTL, &data) < 0) {
+        AP_HAL::panic("GPIO_TBot: read BCM pin %u: %s", pin, strerror(errno));
+        return 0;
+    }
+    _values[pin] = data.values[0] != 0;
+    return _values[pin];
+}
+
+void GPIO_TBot::write(uint8_t pin, uint8_t value)
+{
+    if (!valid_pin(pin) || _line_fds[pin] < 0) {
+        AP_HAL::panic("GPIO_TBot: BCM pin %u is not an output", pin);
+        return;
+    }
+
+    gpiohandle_data data{};
+    data.values[0] = value != 0;
+    if (ioctl(_line_fds[pin], GPIOHANDLE_SET_LINE_VALUES_IOCTL, &data) < 0) {
+        AP_HAL::panic("GPIO_TBot: write BCM pin %u: %s", pin, strerror(errno));
+        return;
+    }
+    _values[pin] = data.values[0];
+}
+
+void GPIO_TBot::toggle(uint8_t pin)
+{
+    write(pin, !read(pin));
+}
+
+AP_HAL::DigitalSource* GPIO_TBot::channel(uint16_t pin)
+{
+    return NEW_NOTHROW DigitalSource(pin);
+}
+
+bool GPIO_TBot::usb_connected()
+{
+    return false;
+}
+
+#endif  // HAL_LINUX_GPIO_TBOT_ENABLED
