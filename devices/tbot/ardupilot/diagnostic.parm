# Explicit, temporary TBot ArduPilot diagnostic profile.
#
# This file is layered after defaults.parm only when the volatile
# diagnostic-logging.enabled marker is present in the TBot ArduPilot runtime
# directory. It enables comprehensive DataFlash file logging in /var/tmp,
# which is a 96 MiB tmpfs on the sealed board. Its contents are intentionally
# lost at reboot.
LOG_BACKEND_TYPE 1
LOG_BITMASK 65535
LOG_DISARMED 1
