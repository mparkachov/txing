{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://txing.local/schemas/txing-tbot-sparkplug-shadow.schema.json",
  "title": "TBot Sparkplug Named Shadow Contract",
  "description": "Named shadow 'sparkplug' AWS-side materialized Sparkplug view for a tbot.",
  "type": "object",
  "additionalProperties": true,
  "required": ["state"],
  "properties": {
    "state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["reported"],
      "properties": {
        "reported": {
          "type": "object",
          "additionalProperties": true,
          "required": ["topic", "payload"],
          "properties": {
            "topic": {
              "type": "object",
              "additionalProperties": true,
              "required": ["namespace", "groupId", "messageType", "edgeNodeId", "deviceId"],
              "properties": {
                "namespace": {"const": "spBv1.0"},
                "groupId": {"type": "string", "minLength": 1},
                "messageType": {"enum": ["NBIRTH", "NDATA", "NDEATH", "DBIRTH", "DDATA", "DDEATH"]},
                "edgeNodeId": {"type": "string", "minLength": 1},
                "deviceId": {"type": "string", "minLength": 1}
              }
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "required": ["metrics"],
              "properties": {"metrics": {"type": "object"}}
            }
          }
        }
      }
    }
  }
}
