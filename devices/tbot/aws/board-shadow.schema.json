{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://txing.local/schemas/txing-tbot-board-shadow.schema.json",
  "title": "TBot Board Named Shadow Contract",
  "type": "object",
  "additionalProperties": true,
  "required": ["state"],
  "properties": {
    "state": {
      "type": "object",
      "additionalProperties": true,
      "required": ["reported"],
      "properties": {
        "reported": {
          "type": "object",
          "additionalProperties": true,
          "required": ["power", "wifi"],
          "properties": {
            "power": {"type": "boolean"},
            "wifi": {
              "type": "object",
              "additionalProperties": true,
              "required": ["online"],
              "properties": {
                "online": {"type": "boolean"},
                "ipv4": {"type": ["string", "null"], "format": "ipv4"},
                "ipv6": {"type": ["string", "null"], "format": "ipv6"}
              }
            }
          }
        }
      }
    }
  }
}
