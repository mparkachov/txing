mainmenu "txing power-nrf MCU"

source "Kconfig.zephyr"

config TXING_POWER_NRF_SED_RECOVERY
	bool "Use exponential SED-only Thread recovery"
	help
	  Retry a lost sleepy Thread attachment with a capped exponential backoff,
	  without returning to receiver-on bootstrap mode.

config TXING_POWER_NRF_RECEIVER_ON_DIAGNOSTICS
	bool "Use receiver-on Thread recovery diagnostics"
	help
	  Keep ordinary debug recovery in receiver-on mode after a lost SED
	  attachment. This diagnostic option is intentionally incompatible with
	  the release and SED-debug exponential SED-only policy.
