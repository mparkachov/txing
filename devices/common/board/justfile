set shell := ["sh", "-eu", "-c"]
set quiet := true

board_dir := source_directory()
project_root := canonicalize(board_dir + "/../../..")
tmp_dir := project_root + "/tmp"
export TMPDIR := tmp_dir
export GOPATH := tmp_dir + "/go/gopath"
export GOMODCACHE := tmp_dir + "/go/gopath/pkg/mod"
export GOCACHE := tmp_dir + "/go/build"

root_justfile := project_root + "/justfile"
board_justfile := board_dir + "/justfile"
aws_lib := project_root + "/shared/aws/scripts/aws_lib.sh"
daemon_dir := board_dir + "/daemon"
daemon_module := "github.com/mparkachov/txing/devices/common/board/daemon"
native_kvs_master_dir := board_dir + "/kvs_master"
native_hardware_worker_dir := board_dir + "/hardware_worker"
board_proto_dir := board_dir + "/proto"
aws_kvs_sdk_commit := "bb106510cf74edd2c24881c1ae94ceaa0083d15c"
default_kvs_system_ca_cert_path := env_var_or_default("TXING_BOARD_KVS_SYSTEM_CA_CERT_PATH", "/etc/ssl/certs/Starfield_Services_Root_Certificate_Authority_-_G2.pem")

# Pinned to the versions the previously checked-in bindings were generated with.
protoc_gen_go_version := "v1.36.10"
protoc_gen_go_grpc_version := "v1.5.1"

alpine_build_image := "docker.io/library/alpine:3.24.1"
alpine_build_platform := "linux/arm64"

# Alpine apk ships no static archives for the gRPC stack (doc-30); the
# hardware worker's static protobuf/gRPC dependencies are source-built by
# release/scripts/build-board-static-toolchain.sh into this cached prefix.
static_toolchain_dir := board_dir + "/target/alpine-static-toolchain"

# Every recipe takes the board device type as its first argument. It selects the
# proto package under devices/<device>/proto, the binary names, and the release
# stream in release/versions/<device>.
[private]
@_require-device device:
    #!/bin/sh
    set -eu
    device="{{device}}"
    if [ -z "$device" ]; then
      echo "a board device type is required, for example: just common::board::test unit" >&2
      exit 2
    fi
    if [ ! -f "{{project_root}}/devices/$device/manifest.toml" ]; then
      echo "unknown board device type '$device': devices/$device/manifest.toml does not exist" >&2
      exit 2
    fi
    if [ ! -f "{{project_root}}/release/versions/$device" ]; then
      echo "board device type '$device' has no release stream at release/versions/$device" >&2
      exit 2
    fi

[private]
@_require-hardware-worker-device device:
    #!/bin/sh
    set -eu
    if [ "{{device}}" != "unit" ]; then
      echo "the hardware worker is a Unit-only board component; Cyberbrick uses ArduPilot and MAVLink" >&2
      exit 2
    fi

[private]
@_device-version device:
    #!/bin/sh
    set -eu
    version_file="{{project_root}}/release/versions/{{device}}"
    version="$(tr -d '[:space:]' < "$version_file")"
    if ! printf '%s\n' "$version" | grep -E -q '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'; then
      echo "$version_file must contain a semantic version like x.y.z." >&2
      exit 1
    fi
    printf '%s\n' "$version"

# Regenerate the daemon's Go bindings (device-independent, not checked in).
proto-gen:
    #!/bin/sh
    set -eu
    proto_root="{{board_proto_dir}}"
    out_dir="{{daemon_dir}}/internal/proto"

    for command in go protoc; do
      if ! command -v "$command" >/dev/null 2>&1; then
        echo "board proto-gen requires '$command'." >&2
        exit 1
      fi
    done

    plugin_dir="{{tmp_dir}}/go/protoc-plugins"
    install -d "$plugin_dir"
    GOBIN="$plugin_dir" go install "google.golang.org/protobuf/cmd/protoc-gen-go@{{protoc_gen_go_version}}"
    GOBIN="$plugin_dir" go install "google.golang.org/grpc/cmd/protoc-gen-go-grpc@{{protoc_gen_go_grpc_version}}"

    rm -rf "$out_dir"
    install -d "$out_dir"
    hardware_proto="txing/board/hardware/v1/hardware.proto"
    board_video_proto="txing/board/board_video/v1/board_video.proto"
    mavlink_proto="txing/board/mavlink/v1/mavlink.proto"
    mavlink_bridge_proto="txing/board/mavlink_bridge/v1/mavlink_bridge.proto"
    mavlink_proto_root="{{project_root}}/devices/cyberbrick/proto"
    PATH="$plugin_dir:$PATH" protoc \
      "--proto_path=$proto_root" \
      "--proto_path=$mavlink_proto_root" \
      "--go_out=$out_dir" \
      "--go_opt=module={{daemon_module}}/internal/proto" \
      "--go_opt=M$hardware_proto={{daemon_module}}/internal/proto/hardwarev1" \
      "--go_opt=M$board_video_proto={{daemon_module}}/internal/proto/boardvideov1" \
      "--go_opt=M$mavlink_proto={{daemon_module}}/internal/proto/mavlinkv1" \
      "--go_opt=M$mavlink_bridge_proto={{daemon_module}}/internal/proto/mavlinkbridgev1" \
      "--go-grpc_out=$out_dir" \
      "--go-grpc_opt=module={{daemon_module}}/internal/proto" \
      "--go-grpc_opt=M$hardware_proto={{daemon_module}}/internal/proto/hardwarev1" \
      "--go-grpc_opt=M$board_video_proto={{daemon_module}}/internal/proto/boardvideov1" \
      "--go-grpc_opt=M$mavlink_proto={{daemon_module}}/internal/proto/mavlinkv1" \
      "--go-grpc_opt=M$mavlink_bridge_proto={{daemon_module}}/internal/proto/mavlinkbridgev1" \
      "$hardware_proto" \
      "$board_video_proto" \
      "$mavlink_proto" \
      "$mavlink_bridge_proto"

role-policy device thing_id='':
    #!/bin/sh
    set -eu
    just --quiet --justfile "{{board_justfile}}" _require-device "{{device}}"
    requested_thing_name="{{thing_id}}"
    case "$requested_thing_name" in *=*) echo "Do not pass just recipe arguments as name=value. Use: just common::board::role-policy {{device}} <thing-id>" >&2; exit 2 ;; esac
    if [ -n "$requested_thing_name" ]; then
      export TXING_THING_ID="$requested_thing_name"
    fi
    . "{{aws_lib}}"
    eval "$(just --justfile "{{root_justfile}}" _project-aws-env device)"
    txing_aws_init
    effective_thing_name="${requested_thing_name:-$THING_NAME}"
    case "$effective_thing_name" in *=*) echo "Invalid Thing ID '$effective_thing_name'. Use positional just arguments, for example: just common::board::role-policy {{device}} {{device}}-bl95f2" >&2; exit 2 ;; esac
    if ! printf '%s\n' "$effective_thing_name" | grep -E -q '^[a-zA-Z0-9:_-]+$'; then
      echo "Invalid Thing ID '$effective_thing_name'. Allowed characters: letters, digits, colon, underscore, hyphen." >&2
      exit 2
    fi
    account_id="$(aws sts get-caller-identity --query Account --output text)"
    caller_arn="$(aws sts get-caller-identity --query Arn --output text)"
    partition="$(printf '%s\n' "$caller_arn" | cut -d: -f2)"
    daemon_role_name="txing-daemon-$effective_thing_name"
    if ! aws iam get-role --role-name "$daemon_role_name" >/dev/null 2>&1; then
      echo "Daemon IAM role $daemon_role_name does not exist. Run just aws::cert <thing-id> first." >&2
      exit 1
    fi
    cloudwatch_log_group="txing/${TXING_TOWN_ID}/${TXING_RIG_ID}/${effective_thing_name}"
    credential_policy_file="$(mktemp "${TMPDIR:-/tmp}/txing-daemon-credential-policy.XXXXXX")"
    cleanup() {
      rm -f "$credential_policy_file"
    }
    trap cleanup EXIT
    jq -n \
      --arg iotShadowArn "arn:${partition}:iot:${TXING_AWS_REGION}:${account_id}:thing/${effective_thing_name}/sparkplug" \
      --arg cloudwatchLogGroupArn "arn:${partition}:logs:${TXING_AWS_REGION}:${account_id}:log-group:${cloudwatch_log_group}" \
      --arg cloudwatchLogStreamArn "arn:${partition}:logs:${TXING_AWS_REGION}:${account_id}:log-group:${cloudwatch_log_group}:log-stream:*" \
      --arg kvsChannelArn "arn:${partition}:kinesisvideo:${TXING_AWS_REGION}:${account_id}:channel/${effective_thing_name}-board-video/*" \
      '{Version: "2012-10-17", Statement: [
        {Sid: "DaemonSparkplugShadowRead", Effect: "Allow", Action: "iot:GetThingShadow", Resource: $iotShadowArn},
        {Sid: "DaemonCloudWatchLogsWrite", Effect: "Allow", Action: ["logs:CreateLogGroup", "logs:CreateLogStream", "logs:DescribeLogStreams", "logs:PutRetentionPolicy", "logs:PutLogEvents"], Resource: [$cloudwatchLogGroupArn, $cloudwatchLogStreamArn]},
        {Sid: "DaemonBoardVideoMaster", Effect: "Allow", Action: ["kinesisvideo:DescribeSignalingChannel", "kinesisvideo:GetSignalingChannelEndpoint", "kinesisvideo:GetIceServerConfig", "kinesisvideo:ConnectAsMaster"], Resource: $kvsChannelArn}
      ]}' \
      >"$credential_policy_file"
    aws iam put-role-policy \
      --role-name "$daemon_role_name" \
      --policy-name txing-daemon-own-thing \
      --policy-document "file://$credential_policy_file"
    printf 'refreshed daemon IAM role policy\n'
    printf '  thing: %s\n' "$effective_thing_name"
    printf '  role: %s\n' "$daemon_role_name"
    printf '  video region: %s\n' "$TXING_AWS_REGION"

