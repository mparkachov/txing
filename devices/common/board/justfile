nerdctl-build device:
    #!/bin/sh
    set -eu

    for command in git jq; do
      if ! command -v "$command" >/dev/null 2>&1; then
        echo "board nerdctl-build requires '$command'." >&2
        exit 1
      fi
    done

    just --quiet --justfile "{{board_justfile}}" _alpine-build "{{device}}" all

    device="{{device}}"
    project_root="{{project_root}}"
    output_root="{{board_dir}}/target/nerdctl-build-$device"
    metadata_path="$output_root/metadata.json"
    bin_dir="$output_root/bin"
    version="$(just --quiet --justfile "{{board_justfile}}" _device-version "$device")"
    commit="$(git -C "$project_root" rev-parse HEAD)"
    timestamp="$(date -u +%s)"

    case "$device" in
      unit)
        jq -n \
          --arg version "$version" \
          --arg commit "$commit" \
          --argjson timestamp "$timestamp" \
          --arg daemonBinaryName "txing-$device-daemon" \
          --arg daemonBinaryPath "$bin_dir/txing-$device-daemon" \
          --arg kvsMasterBinaryName "txing-$device-kvs-master" \
          --arg kvsMasterBinaryPath "$bin_dir/txing-$device-kvs-master" \
          --arg hardwareWorkerBinaryName "txing-$device-hardware-worker" \
          --arg hardwareWorkerBinaryPath "$bin_dir/txing-$device-hardware-worker" \
          --arg projectRoot "$project_root" \
          --arg buildImage "{{alpine_build_image}}" \
          --arg buildPlatform "{{alpine_build_platform}}" \
          '{version: $version, commit: $commit, timestamp: $timestamp, outputs: {($daemonBinaryName): $daemonBinaryPath, ($kvsMasterBinaryName): $kvsMasterBinaryPath, ($hardwareWorkerBinaryName): $hardwareWorkerBinaryPath}, projectRoot: $projectRoot, buildImage: $buildImage, buildPlatform: $buildPlatform}' \
          >"$metadata_path"
        component_binary="txing-$device-hardware-worker"
        component_label="hardware worker"
        ;;
      cyberbrick)
        jq -n \
          --arg version "$version" \
          --arg commit "$commit" \
          --argjson timestamp "$timestamp" \
          --arg daemonBinaryName "txing-$device-daemon" \
          --arg daemonBinaryPath "$bin_dir/txing-$device-daemon" \
          --arg kvsMasterBinaryName "txing-$device-kvs-master" \
          --arg kvsMasterBinaryPath "$bin_dir/txing-$device-kvs-master" \
          --arg mavlinkBinaryName "txing-$device-mavlink" \
          --arg mavlinkBinaryPath "$bin_dir/txing-$device-mavlink" \
          --arg projectRoot "$project_root" \
          --arg buildImage "{{alpine_build_image}}" \
          --arg buildPlatform "{{alpine_build_platform}}" \
          '{version: $version, commit: $commit, timestamp: $timestamp, outputs: {($daemonBinaryName): $daemonBinaryPath, ($kvsMasterBinaryName): $kvsMasterBinaryPath, ($mavlinkBinaryName): $mavlinkBinaryPath}, projectRoot: $projectRoot, buildImage: $buildImage, buildPlatform: $buildPlatform}' \
          >"$metadata_path"
        component_binary="txing-$device-mavlink"
        component_label="MAVLink"
        ;;
      *)
        echo "Unsupported board device type '$device'." >&2
        exit 2
        ;;
    esac

    printf 'prepared Alpine aarch64 board binaries\n'
    printf '  device: %s\n' "$device"
    printf '  version: %s\n' "$version"
    printf '  commit: %s\n' "$commit"
    printf '  build image: %s\n' "{{alpine_build_image}}"
    printf '  daemon binary: %s\n' "$bin_dir/txing-$device-daemon"
    printf '  KVS master binary: %s\n' "$bin_dir/txing-$device-kvs-master"
    printf '  %s binary: %s\n' "$component_label" "$bin_dir/$component_binary"
    printf '  metadata: %s\n' "$metadata_path"

nerdctl-smoke device:
    #!/bin/sh
    set -eu
    device="{{device}}"
    bin_dir="{{board_dir}}/target/nerdctl-build-$device/bin"
    version="$(just --quiet --justfile "{{board_justfile}}" _device-version "$device")"
    case "$device" in
      unit) component_binary="txing-$device-hardware-worker" ;;
      cyberbrick) component_binary="txing-$device-mavlink" ;;
      *) echo "Unsupported board device type '$device'." >&2; exit 2 ;;
    esac
    for binary in "txing-$device-daemon" "txing-$device-kvs-master" "$component_binary"; do
      if [ ! -x "$bin_dir/$binary" ]; then
        echo "Missing $bin_dir/$binary. Run just common::board::nerdctl-build $device first." >&2
        exit 1
      fi
    done
    TXING_CONTAINER_CLI=nerdctl sh "{{project_root}}/release/scripts/smoke-board-cross-distro.sh" \
      "$bin_dir/txing-$device-daemon" static "txing-$device-daemon $version"
    TXING_CONTAINER_CLI=nerdctl sh "{{project_root}}/release/scripts/smoke-board-cross-distro.sh" \
      "$bin_dir/$component_binary" static "$component_binary $version"
    TXING_CONTAINER_CLI=nerdctl sh "{{project_root}}/release/scripts/smoke-board-cross-distro.sh" \
      "$bin_dir/txing-$device-kvs-master" musl-libcamera "txing-$device-kvs-master $version"

[private]
@_alpine-build device component:
    #!/bin/sh
    set -eu

    just --quiet --justfile "{{board_justfile}}" _require-device "{{device}}"
    device="{{device}}"
    component="{{component}}"
    project_root="{{project_root}}"
    output_root="{{board_dir}}/target/nerdctl-build-$device"
    output_stage="$output_root/alpine-out"
    toolchain_dir="{{static_toolchain_dir}}"
    image="{{alpine_build_image}}"
    platform="{{alpine_build_platform}}"
    version="$(just --quiet --justfile "{{board_justfile}}" _device-version "$device")"

    case "$component" in
      daemon|kvs-master|hardware-worker|mavlink|all) ;;
      *)
        echo "Unsupported board Alpine component: $component" >&2
        exit 2
        ;;
    esac

    if [ "$component" = "hardware-worker" ] && [ "$device" != "unit" ]; then
      echo "the hardware worker is a Unit-only board component; Cyberbrick uses ArduPilot and MAVLink" >&2
      exit 2
    fi
    if [ "$component" = "mavlink" ] && [ "$device" != "cyberbrick" ]; then
      echo "the MAVLink service is a Cyberbrick-only board component" >&2
      exit 2
    fi

    command -v nerdctl >/dev/null 2>&1 || {
      echo "nerdctl is required to build board projects in Alpine." >&2
      exit 1
    }
    server_platform="$(nerdctl info --format '{{"{{"}}.OSType{{"}}"}}/{{"{{"}}.Architecture{{"}}"}}')"
    case "$server_platform" in
      linux/aarch64|linux/arm64) ;;
      *)
        echo "board Alpine builds require a native linux/arm64 nerdctl environment, got: $server_platform" >&2
        exit 1
        ;;
    esac

    if [ "$component" = "all" ]; then
      rm -rf "$output_root"
    fi
    rm -rf "$output_stage"
    install -d "$output_stage" "$output_root/bin" "$toolchain_dir"

    nerdctl run --rm -i \
      --platform "$platform" \
      --mount "type=bind,source=$project_root,target=$project_root,readonly" \
      --mount "type=bind,source=$output_stage,target=/out" \
      --mount "type=bind,source=$toolchain_dir,target=/toolchain" \
      -w "$project_root" \
      -e TXING_ALPINE_COMPONENT="$component" \
      -e TXING_BOARD_DEVICE_TYPE="$device" \
      -e TXING_BOARD_RELEASE_VERSION="$version" \
      -e TXING_AWS_KVS_WEBRTC_SDK_GIT_TAG="{{aws_kvs_sdk_commit}}" \
      -e TXING_BOARD_KVS_SYSTEM_CA_CERT_PATH="{{default_kvs_system_ca_cert_path}}" \
      -e TXING_PROTOC_GEN_GO_VERSION="{{protoc_gen_go_version}}" \
      -e TXING_PROTOC_GEN_GO_GRPC_VERSION="{{protoc_gen_go_grpc_version}}" \
      "$image" \
      sh -se <<'ALPINE_BUILD'
    set -eu

    expected_release="3.24.1"
    actual_release="$(cat /etc/alpine-release)"
    if [ "$actual_release" != "$expected_release" ]; then
      echo "Expected Alpine $expected_release, got $actual_release" >&2
      exit 1
    fi
    if [ "$(uname -m)" != "aarch64" ]; then
      echo "Expected native aarch64 Alpine container, got $(uname -m)" >&2
      exit 1
    fi

    device="$TXING_BOARD_DEVICE_TYPE"
    version="$TXING_BOARD_RELEASE_VERSION"
    daemon_module="github.com/mparkachov/txing/devices/common/board/daemon"

    apk add --no-cache \
      build-base cmake pkgconf git perl ca-certificates curl \
      curl-dev openssl-dev openssl-libs-static log4cplus-dev libsrtp-dev \
      libusrsctp-dev libwebsockets-dev zlib-dev zlib-static libcamera-dev \
      linux-headers protobuf-dev protobuf grpc-dev grpc-plugins \
      go binutils file

    # Alpine gcc defaults to PIE, so -static produces a static-PIE: file says
    # 'static-pie linked' and the hard invariant is the absent PT_INTERP header.
    assert_static() {
      asserted_binary="$1"
      asserted_name="$2"
      test -x "$asserted_binary"
      file "$asserted_binary" | grep -E 'ELF 64-bit LSB.*ARM aarch64'
      file "$asserted_binary" | grep -E 'statically linked|static-pie linked'
      if readelf -l "$asserted_binary" | grep -Fq 'INTERP'; then
        echo "$asserted_name unexpectedly has an ELF interpreter (not static)" >&2
        exit 1
      fi
    }

    assert_musl_dynamic() {
      asserted_binary="$1"
      asserted_name="$2"
      test -x "$asserted_binary"
      file "$asserted_binary" | grep -E 'ELF 64-bit LSB.*ARM aarch64'
      readelf -l "$asserted_binary" | grep -F '[Requesting program interpreter: /lib/ld-musl-aarch64.so.1]'
      ldd_output="$(ldd "$asserted_binary")"
      printf '%s\n' "$ldd_output"
      if printf '%s\n' "$ldd_output" | grep -Fq 'not found'; then
        echo "$asserted_name has unresolved shared libraries" >&2
        exit 1
      fi
      printf '%s\n' "$ldd_output" | grep -F 'libc.musl-aarch64.so.1'
    }

    # The daemon's Go bindings are generated rather than checked in. The project
    # root is mounted read-only, so generation lands in a writable copy of the
    # daemon module and the build runs from there.
    daemon_workdir=""
    generate_go_bindings() {
      daemon_workdir="$(mktemp -d /tmp/txing-board-daemon-src.XXXXXX)"
      cp -a "$PWD/devices/common/board/daemon/." "$daemon_workdir/"
      plugin_dir="$(mktemp -d /tmp/txing-protoc-plugins.XXXXXX)"
      GOBIN="$plugin_dir" go install "google.golang.org/protobuf/cmd/protoc-gen-go@$TXING_PROTOC_GEN_GO_VERSION"
      GOBIN="$plugin_dir" go install "google.golang.org/grpc/cmd/protoc-gen-go-grpc@$TXING_PROTOC_GEN_GO_GRPC_VERSION"
      proto_root="$PWD/devices/common/board/proto"
      mavlink_proto_root="$PWD/devices/cyberbrick/proto"
      out_dir="$daemon_workdir/internal/proto"
      hardware_proto="txing/board/hardware/v1/hardware.proto"
      board_video_proto="txing/board/board_video/v1/board_video.proto"
      mavlink_proto="txing/board/mavlink/v1/mavlink.proto"
      mavlink_bridge_proto="txing/board/mavlink_bridge/v1/mavlink_bridge.proto"
      rm -rf "$out_dir"
      install -d "$out_dir"
      PATH="$plugin_dir:$PATH" protoc \
        "--proto_path=$proto_root" \
        "--proto_path=$mavlink_proto_root" \
        "--go_out=$out_dir" \
        "--go_opt=module=$daemon_module/internal/proto" \
        "--go_opt=M$hardware_proto=$daemon_module/internal/proto/hardwarev1" \
        "--go_opt=M$board_video_proto=$daemon_module/internal/proto/boardvideov1" \
        "--go_opt=M$mavlink_proto=$daemon_module/internal/proto/mavlinkv1" \
        "--go_opt=M$mavlink_bridge_proto=$daemon_module/internal/proto/mavlinkbridgev1" \
        "--go-grpc_out=$out_dir" \
        "--go-grpc_opt=module=$daemon_module/internal/proto" \
        "--go-grpc_opt=M$hardware_proto=$daemon_module/internal/proto/hardwarev1" \
        "--go-grpc_opt=M$board_video_proto=$daemon_module/internal/proto/boardvideov1" \
        "--go-grpc_opt=M$mavlink_proto=$daemon_module/internal/proto/mavlinkv1" \
        "--go-grpc_opt=M$mavlink_bridge_proto=$daemon_module/internal/proto/mavlinkbridgev1" \
        "$hardware_proto" \
        "$board_video_proto" \
        "$mavlink_proto" \
        "$mavlink_bridge_proto"
    }

    build_daemon() {
      daemon_source="$daemon_workdir"
      daemon_build="$(mktemp -d /tmp/txing-board-daemon.XXXXXX)"
      (
        cd "$daemon_source"
        GOOS=linux GOARCH=arm64 CGO_ENABLED=0 go test ./...
        GOOS=linux GOARCH=arm64 CGO_ENABLED=0 \
          go build -trimpath -buildvcs=false \
            -ldflags="-s -w -X $daemon_module/internal/daemon.DeviceType=$device -X $daemon_module/internal/daemon.DaemonVersion=$version" \
            -o "$daemon_build/txing-$device-daemon" \
            ./cmd/txing-board-daemon
      )
      assert_static "$daemon_build/txing-$device-daemon" "txing-$device-daemon"
      "$daemon_build/txing-$device-daemon" --version
      install -m 755 "$daemon_build/txing-$device-daemon" "/out/txing-$device-daemon"
    }

    build_hardware_worker() {
      sh release/scripts/build-board-static-toolchain.sh /toolchain
      hardware_source="$PWD/devices/common/board/hardware_worker"
      hardware_build="$(mktemp -d /tmp/txing-board-hardware-worker.XXXXXX)"
      PATH="/toolchain/bin:$PATH" cmake \
        -S "$hardware_source" \
        -B "$hardware_build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=ON \
        -DTXING_BOARD_DEVICE_TYPE="$device" \
        -DTXING_BOARD_HARDWARE_WORKER_VERSION="$version" \
        -DTXING_HARDWARE_WORKER_GRPC=ON \
        -DCMAKE_PREFIX_PATH=/toolchain \
        -DCMAKE_EXE_LINKER_FLAGS=-static \
        -DOPENSSL_USE_STATIC_LIBS=TRUE \
        -DZLIB_USE_STATIC_LIBS=ON
      PATH="/toolchain/bin:$PATH" cmake --build "$hardware_build" --config Release
      ctest --test-dir "$hardware_build" --output-on-failure
      assert_static "$hardware_build/txing-$device-hardware-worker" "txing-$device-hardware-worker"
      "$hardware_build/txing-$device-hardware-worker" --version
      install -m 755 "$hardware_build/txing-$device-hardware-worker" "/out/txing-$device-hardware-worker"
    }

    build_mavlink() {
      mavlink_source="$daemon_workdir"
      mavlink_build="$(mktemp -d /tmp/txing-board-mavlink.XXXXXX)"
      (
        cd "$mavlink_source"
        GOOS=linux GOARCH=arm64 CGO_ENABLED=0 \
          go build -trimpath -buildvcs=false \
            -ldflags="-s -w -X $daemon_module/internal/daemon.DeviceType=$device -X $daemon_module/internal/daemon.DaemonVersion=$version" \
            -o "$mavlink_build/txing-$device-mavlink" \
            ./cmd/txing-board-mavlink
      )
      assert_static "$mavlink_build/txing-$device-mavlink" "txing-$device-mavlink"
      "$mavlink_build/txing-$device-mavlink" --version
      install -m 755 "$mavlink_build/txing-$device-mavlink" "/out/txing-$device-mavlink"
    }

    build_kvs_master() {
      kvs_source="$PWD/devices/common/board/kvs_master"
      kvs_build="$(mktemp -d /tmp/txing-board-kvs-master.XXXXXX)"
      openssl_libdir="$(pkg-config --variable=libdir openssl)"
      openssl_includedir="$(pkg-config --variable=includedir openssl)"
      cmake \
        -S "$kvs_source" \
        -B "$kvs_build" \
        -DCMAKE_BUILD_TYPE=Release \
        -DBUILD_TESTING=ON \
        -DTXING_BOARD_DEVICE_TYPE="$device" \
        -DTXING_BOARD_KVS_MASTER_VERSION="$version" \
        -DTXING_KVS_SYSTEM_CA_CERT_PATH="$TXING_BOARD_KVS_SYSTEM_CA_CERT_PATH" \
        -DTXING_KVS_GRPC_BRIDGE=ON \
        -DTXING_AWS_KVS_WEBRTC_SDK_GIT_TAG="$TXING_AWS_KVS_WEBRTC_SDK_GIT_TAG" \
        -DOPENSSL_USE_STATIC_LIBS=FALSE \
        -DOPENSSL_INCLUDE_DIR="$openssl_includedir" \
        -DOPENSSL_SSL_LIBRARY="$openssl_libdir/libssl.so" \
        -DOPENSSL_CRYPTO_LIBRARY="$openssl_libdir/libcrypto.so"
      cmake --build "$kvs_build" --config Release
      ctest --test-dir "$kvs_build" --output-on-failure
      assert_musl_dynamic "$kvs_build/txing-$device-kvs-master" "txing-$device-kvs-master"
      kvs_ldd="$(ldd "$kvs_build/txing-$device-kvs-master")"
      printf '%s\n' "$kvs_ldd" | grep -F 'libcamera.so.0.7'
      printf '%s\n' "$kvs_ldd" | grep -F 'libcamera-base.so.0.7'
      "$kvs_build/txing-$device-kvs-master" --version
      install -m 755 "$kvs_build/txing-$device-kvs-master" "/out/txing-$device-kvs-master"
    }

    case "$TXING_ALPINE_COMPONENT" in
      daemon)
        generate_go_bindings
        build_daemon
        ;;
      kvs-master)
        build_kvs_master
        ;;
      hardware-worker)
        build_hardware_worker
        ;;
      mavlink)
        generate_go_bindings
        build_mavlink
        ;;
      all)
        generate_go_bindings
        build_daemon
        build_kvs_master
        case "$device" in
          unit) build_hardware_worker ;;
          cyberbrick) build_mavlink ;;
        esac
        ;;
    esac
    ALPINE_BUILD

    case "$component" in
      daemon)
        install -m 755 "$output_stage/txing-$device-daemon" "$output_root/bin/txing-$device-daemon"
        ;;
      kvs-master)
        install -m 755 "$output_stage/txing-$device-kvs-master" "$output_root/bin/txing-$device-kvs-master"
        ;;
      hardware-worker)
        install -m 755 "$output_stage/txing-$device-hardware-worker" "$output_root/bin/txing-$device-hardware-worker"
        ;;
      mavlink)
        install -m 755 "$output_stage/txing-$device-mavlink" "$output_root/bin/txing-$device-mavlink"
        ;;
      all)
        install -m 755 "$output_stage/txing-$device-daemon" "$output_root/bin/txing-$device-daemon"
        install -m 755 "$output_stage/txing-$device-kvs-master" "$output_root/bin/txing-$device-kvs-master"
        case "$device" in
          unit)
            install -m 755 "$output_stage/txing-$device-hardware-worker" "$output_root/bin/txing-$device-hardware-worker"
            ;;
          cyberbrick)
            install -m 755 "$output_stage/txing-$device-mavlink" "$output_root/bin/txing-$device-mavlink"
            ;;
        esac
        ;;
    esac
    rm -rf "$output_stage"

clean device='':
    #!/bin/sh
    set -eu
    device="{{device}}"
    if [ -n "$device" ]; then
      rm -rf \
        "{{native_kvs_master_dir}}/build-$device" \
        "{{native_kvs_master_dir}}/build-tests-$device" \
        "{{native_hardware_worker_dir}}/build-$device" \
        "{{native_hardware_worker_dir}}/build-tests-$device" \
        "{{board_dir}}/target/nerdctl-build-$device" \
        "{{board_dir}}/target/docker-build-$device"
    else
      rm -rf \
        "{{native_kvs_master_dir}}"/build-* \
        "{{native_hardware_worker_dir}}"/build-* \
        "{{board_dir}}"/target/nerdctl-build-* \
        "{{board_dir}}"/target/docker-build-* \
        "{{board_dir}}/aws-kvs-webrtc-sdk-build" \
        "{{board_dir}}/aws-kvs-webrtc-sdk-install" \
        "{{board_dir}}/aws-kvs-webrtc-sdk-system-deps" \
        "{{static_toolchain_dir}}"
    fi
    rm -rf "{{daemon_dir}}/internal/proto"

@default:
    @just --list
