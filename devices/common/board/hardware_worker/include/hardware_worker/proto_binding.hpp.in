#ifndef TXING_BOARD_HARDWARE_WORKER_PROTO_BINDING_HPP
#define TXING_BOARD_HARDWARE_WORKER_PROTO_BINDING_HPP

// Generated by CMake from the device profile. The hardware service name is
// device-independent (BoardHardware), but its proto package is still per
// device, so the generated header path and namespace are resolved here and the
// shared sources only refer to txing::board::proto::hardware_v1.
#include "txing/@TXING_BOARD_DEVICE_TYPE@/hardware/v1/@TXING_BOARD_DEVICE_TYPE@_hardware.grpc.pb.h"

namespace txing::board::proto {
namespace hardware_v1 = ::txing::@TXING_BOARD_DEVICE_TYPE@::hardware::v1;
}  // namespace txing::board::proto

#endif
