#!/sbin/openrc-run

description="Txing TBot Board Hardware Worker"

supervisor=supervise-daemon
command=/root/.local/share/mise/installs/txing-tbot-hardware-worker/latest/txing-tbot-hardware-worker
directory=/root
respawn_delay=2
respawn_max=5
respawn_period=600
output_log=/var/log/txing-tbot-hardware-worker.log
error_log=/var/log/txing-tbot-hardware-worker.log

daemon_env=/root/.config/txing/tbot-daemon/daemon.env

depend() {
    need localmount
    before txing-tbot-daemon
}

start_pre() {
    test -x "$command" || return 1
    test -r "$daemon_env" || return 1
    checkpath --directory --mode 0755 --owner root:root /run/txing-tbot-hardware-worker
    set -a
    . "$daemon_env"
    set +a
    export HOME=/root
}
