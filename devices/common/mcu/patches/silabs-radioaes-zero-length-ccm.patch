+
+// RadioAES CCM requires an AESPAYLOAD descriptor. For an empty message, build
+// the CCM tag directly from B0, formatted AAD, and S0 instead.
+SL_CODE_CLASSIFY(SL_CODE_COMPONENT_SLI_PROTOCOL_CRYPTO, SL_CODE_CLASS_TIME_CRITICAL)
+static sl_status_t aes_ccm_radio_encrypt_empty_payload(const unsigned char *add_data,
+                                                        size_t              add_length,
+                                                        const unsigned char *key,
+                                                        const unsigned char *header,
+                                                        size_t              header_length,
+                                                        unsigned char       *tag,
+                                                        size_t              tag_length)
+{
+  uint8_t mac[AES_BLOCK_BYTES] = { 0 };
+  uint8_t block[AES_BLOCK_BYTES];
+  uint8_t counter[AES_BLOCK_BYTES] = { 0 };
+  size_t offset = 0;
+  size_t total_length = header_length + add_length;
+  size_t counter_length = (header[0] & 0x07U) + 1U;
+  sl_status_t status;
+
+  while (offset < total_length) {
+    for (size_t i = 0; i < AES_BLOCK_BYTES; i++) {
+      uint8_t byte = 0;
+
+      if (offset < total_length) {
+        byte = offset < header_length ? header[offset] : add_data[offset - header_length];
+        offset++;
+      }
+      block[i] = mac[i] ^ byte;
+    }
+
+    status = sli_aes_crypt_ecb_radio(true, key, AES_128_KEY_BYTES * 8U, block, mac);
+    if (status != SL_STATUS_OK) {
+      return status;
+    }
+  }
+
+  counter[0] = header[0] & 0x07U;
+  for (size_t i = 0; i < AES_BLOCK_BYTES - 1U - counter_length; i++) {
+    counter[i + 1U] = header[i + 1U];
+  }
+
+  status = sli_aes_crypt_ecb_radio(true, key, AES_128_KEY_BYTES * 8U, counter, block);
+  if (status != SL_STATUS_OK) {
+    return status;
+  }
 
+  for (size_t i = 0; i < tag_length; i++) {
+    tag[i] = mac[i] ^ block[i];
+  }
+
+  return SL_STATUS_OK;
+}
+
