# Deterministic archives from one tested, frozen Linux ARM64 build.
cmake_minimum_required(VERSION 3.24)
foreach(required IN ITEMS STAGE_DIR SOURCE_DIR PACKAGE_DIR VERSION)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
if(NOT VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
  message(FATAL_ERROR "Strict MAJOR.MINOR.PATCH required")
endif()
file(MAKE_DIRECTORY "${PACKAGE_DIR}")
foreach(required IN ITEMS runtime/txing/txing-agent runtime/snapsafe/libcrypto.so.3
    runtime/snapsafe/libssl.so.3 controller/bootstrap controller/provenance/runtime-links.txt
    controller/provenance/bootstrap-smoke.txt runtime/txing/ctest.txt)
  if(NOT EXISTS "${STAGE_DIR}/${required}")
    message(FATAL_ERROR "Missing tested release content: ${required}")
  endif()
endforeach()

# Every file, including dependency/provenance files, has a stable order and mtime.
# Avoid directory entries: their host mtimes differ even with identical content.
function(archive_tree directory output)
  file(REMOVE "${directory}/SHA256SUMS")
  file(GLOB_RECURSE paths LIST_DIRECTORIES false RELATIVE "${directory}" "${directory}/*")
  list(SORT paths)
  set(checksums "")
  foreach(path IN LISTS paths)
    file(SHA256 "${directory}/${path}" hash)
    string(APPEND checksums "${hash}  ${path}\n")
  endforeach()
  file(WRITE "${directory}/SHA256SUMS" "${checksums}")
  list(APPEND paths SHA256SUMS)
  list(SORT paths)
  # Resolve archive input paths relative to their staging directory.
  execute_process(COMMAND "${CMAKE_COMMAND}" -E chdir "${directory}"
    "${CMAKE_COMMAND}" "-DOUTPUT=${output}" "-DPATHS=${paths}"
    -P "${CMAKE_CURRENT_LIST_DIR}/ReleaseArchive.cmake" COMMAND_ERROR_IS_FATAL ANY)
endfunction()

file(COPY "${SOURCE_DIR}/Release.Dockerfile" DESTINATION "${STAGE_DIR}/microvm")
file(RENAME "${STAGE_DIR}/microvm/Release.Dockerfile" "${STAGE_DIR}/microvm/Dockerfile")
file(COPY "${STAGE_DIR}/runtime" DESTINATION "${STAGE_DIR}/microvm")
file(COPY "${SOURCE_DIR}/hooks.json" DESTINATION "${PACKAGE_DIR}")
file(COPY "${SOURCE_DIR}/stack.yaml" DESTINATION "${PACKAGE_DIR}")
file(COPY "${SOURCE_DIR}/source.tar" "${SOURCE_DIR}/source-sha256.txt"
  "${SOURCE_DIR}/source-revision.txt" "${SOURCE_DIR}/source-status.txt"
  "${SOURCE_DIR}/build-id.txt" DESTINATION "${PACKAGE_DIR}/provenance")
file(COPY "${SOURCE_DIR}/physical-acceptance.md" "${SOURCE_DIR}/container-base.txt"
  DESTINATION "${PACKAGE_DIR}/provenance")
archive_tree("${STAGE_DIR}/microvm" "${PACKAGE_DIR}/microvm.zip")
archive_tree("${STAGE_DIR}/controller" "${PACKAGE_DIR}/controller.zip")
archive_tree("${PACKAGE_DIR}/provenance" "${PACKAGE_DIR}/provenance.zip")
file(REMOVE_RECURSE "${PACKAGE_DIR}/provenance")
file(READ "${SOURCE_DIR}/source-revision.txt" revision)
file(READ "${SOURCE_DIR}/build-id.txt" build_id)
file(READ "${SOURCE_DIR}/source-status.txt" dirty)
string(STRIP "${revision}" revision)
string(STRIP "${build_id}" build_id)
set(clean true)
if(NOT dirty STREQUAL "")
  set(clean false)
endif()
set(files "")
foreach(path IN ITEMS microvm.zip controller.zip provenance.zip hooks.json stack.yaml)
  file(SHA256 "${PACKAGE_DIR}/${path}" hash)
  if(NOT files STREQUAL "")
    string(APPEND files ",\n")
  endif()
  string(APPEND files "    \"${path}\": \"${hash}\"")
endforeach()
file(READ "${SOURCE_DIR}/container-base.txt" base)
string(STRIP "${base}" base)
file(WRITE "${PACKAGE_DIR}/release.json" "{\n  \"component\": \"agent\",\n  \"version\": \"${VERSION}\",\n  \"architecture\": \"linux/arm64\",\n  \"revision\": \"${revision}\",\n  \"buildId\": \"${build_id}\",\n  \"clean\": ${clean},\n  \"containerBase\": \"${base}\",\n  \"localPhysicalAcceptance\": \"docs/history/acceptance/agent-physical-acceptance.md#timeout-record-and-closure-decision--2026-10-28\",\n  \"files\": {\n${files}\n  }\n}\n")
archive_tree("${PACKAGE_DIR}" "${PACKAGE_DIR}/../txing-agent-release-linux-arm64.zip")
